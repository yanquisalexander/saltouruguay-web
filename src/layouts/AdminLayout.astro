---
import AdminSidebar from "@/components/admin/AdminSidebar";
import PageBackdrop from "@/components/PageBackdrop.astro";
import Layout from "@/layouts/Layout.astro";
import type { Session } from "@auth/core/types";
import { LucideExternalLink, LucideShieldCheck } from "lucide-preact";

interface Props {
  session: Session | null;
  title?: string;
  description?: string;
}

const { session, title = "Dashboard", description } = Astro.props;
---

<Layout
  title={`Admin - ${title}`}
  description={description}
  hideFooter
  hideHeader
  mainClassname="bg-[#08080a] text-white overflow-hidden p-0"
>
  {/* Contenedor Principal: Flex Row en Desktop, Flex Col en Mobile */}
  <div class="flex flex-col md:flex-row h-dvh w-full overflow-hidden bg-[#08080a]">
    {/* Sidebar (Control de navegación principal) */}
    <AdminSidebar
      session={session}
      initialPathname={Astro.url.pathname}
      client:load
      transition:persist="admin-sidebar"
    />

    {/* Área de Contenido Principal */}
    <div class="flex flex-1 flex-col min-w-0 overflow-hidden bg-[#0c0c10] relative pt-16 md:pt-0">
      {/* HEADER SUPERIOR (BARRA DE CONTROL STICKY) */}
      <header
        class="relative h-16 shrink-0 border-b border-white/10 bg-[#08080a]/80 backdrop-blur-md flex items-center px-4 md:px-6 justify-between z-30 sticky top-0"
      >
        {/* Línea de acento superior */}
        <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-violet-400/40 to-transparent pointer-events-none"></div>

        <div class="flex items-center gap-3 min-w-0">
          <span class="relative flex size-2 shrink-0" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
          </span>
          <h1
            class="font-anton text-lg md:text-xl uppercase tracking-wide text-white truncate leading-none"
          >
            {title}
          </h1>
          {
            description && (
              <>
                <span class="hidden lg:block w-px h-4 bg-white/10 mx-1 shrink-0" />
                <p class="hidden lg:block text-xs text-white/40 font-rubik truncate max-w-md">
                  {description}
                </p>
              </>
            )
          }
        </div>

        {/* Acciones e Indicadores a la derecha */}
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white/70 hover:text-white text-[11px] font-bold uppercase tracking-wider transition-all"
            title="Abrir sitio web en nueva pestaña"
          >
            <LucideExternalLink size={13} />
            <span>Ver Sitio</span>
          </a>

          <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-violet-500/10 border border-violet-400/25 text-violet-200 text-[11px] font-bold uppercase tracking-wider">
            <LucideShieldCheck size={13} className="text-violet-300" />
            <span>V2.0 Prod</span>
          </span>
        </div>
      </header>

      {/* ÁREA SCROLLABLE DE CONTENIDO */}
      <main class="flex-1 overflow-y-auto overflow-x-clip p-4 sm:p-6 lg:p-8 relative scroll-smooth">
        <PageBackdrop tone="violet" fixed={false} />

        <div class="relative z-10 max-w-7xl mx-auto space-y-6">
          <slot />
        </div>
      </main>
    </div>
  </div>
</Layout>
