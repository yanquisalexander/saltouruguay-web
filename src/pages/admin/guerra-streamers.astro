---
import { checkAdmin } from "@/lib/checkAdmin";
import { getSession } from "auth-astro/server";
import { GameSelector } from "@/components/admin/streamer-wars/GameSelector";
import { StreamerWarsAdmin } from "@/components/admin/StreamerWarsAdmin";
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";

const session = await getSession(Astro.request);

const checkResult = await checkAdmin(session);
if (checkResult) {
  return checkResult;
}
---

<AdminLayout title="Streamer Wars" session={session} description="Panel de control de Guerra de Streamers">
  <div class="space-y-6">
    <AdminPageHeader
      title="Guerra de Streamers"
      description="Gestiona jornadas, jugadores y anuncios del evento en vivo."
      pathname="/admin/guerra-streamers"
      badge="En Vivo"
      badgeTone="emerald"
    />

    <div class="relative z-10 max-w-6xl mx-auto space-y-6">
      <GameSelector client:idle />

      <StreamerWarsAdmin client:idle session={session!} />
    </div>
  </div>
</AdminLayout>
