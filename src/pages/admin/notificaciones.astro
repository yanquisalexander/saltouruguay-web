---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import NotificationsManager from "@/components/admin/NotificationsManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout
  title="Notificaciones"
  session={session}
  description="Emisión de anuncios y notificaciones push para la comunidad"
>
  <div class="space-y-6">
    <AdminPageHeader
      title="Centro de Notificaciones"
      description="Envía avisos al centro de notificaciones web y push a todos los miembros o a destinatarios específicos."
      pathname="/admin/notificaciones"
      badge="Push & Feed"
      badgeTone="violet"
    />
    <NotificationsManager client:load />
  </div>
</AdminLayout>
