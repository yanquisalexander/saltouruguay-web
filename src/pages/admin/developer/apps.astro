---
import { getSession } from "auth-astro/server";
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import { OAuthClientsManager } from "@/components/admin/OAuthClientsManager";

const session = await getSession(Astro.request);
if (!session?.user?.isAdmin) {
    return new Response(null, { status: 404 });
}
---

<AdminLayout title="OAuth Apps" session={session}>
    <div class="space-y-6">
        <AdminPageHeader title="OAuth Apps" pathname="/admin/developer/apps" description="Gestión de clientes OAuth del sistema." />
        <OAuthClientsManager client:load />
    </div>
</AdminLayout>
