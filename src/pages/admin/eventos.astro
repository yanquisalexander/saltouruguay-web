---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import EventsManager from "@/components/admin/EventsManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout
  title="Eventos"
  session={session}
  description="Gestión y programación de eventos comunitarios"
>
  <div class="space-y-6">
    <AdminPageHeader
      title="Gestión de Eventos"
      description="Crea, edita y administra los eventos comunitarios y el calendario en vivo del servidor."
      pathname="/admin/eventos"
      badge="Agenda"
      badgeTone="violet"
    />
    <EventsManager client:only="preact" />
  </div>
</AdminLayout>
