---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import EventsManager from "@/components/admin/EventsManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout title="Eventos" session={session}>
  <div class="flex flex-col w-full max-w-6xl mx-auto space-y-6">
    <AdminPageHeader
      title="Gestión de Eventos"
      description="Crea, edita y administra los eventos comunitarios y calendarios en vivo."
      pathname="/admin/eventos"
    />
    <EventsManager client:only />
  </div>
</AdminLayout>
