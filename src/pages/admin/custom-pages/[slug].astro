---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import { CustomPageEditor } from "@/components/admin/CustomPageEditor";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getCustomPageBySlug } from "@/utils/custom-pages";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
const slug = Astro.params.slug;

if (!session?.user.isAdmin || !slug) {
  return new Response(null, {
    status: 404,
  });
}

const customPage = await getCustomPageBySlug(slug);

if (!customPage) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout title={`Editor · ${customPage.title}`} session={session}>
  <div class="space-y-6">
    <AdminPageHeader
      title={`Editor: ${customPage.title}`}
      description="Personaliza el contenido en bloques, revisa el historial de versiones y publica cambios en vivo."
      pathname={`/admin/custom-pages/${slug}`}
      badge={customPage.isDraft ? "Borrador" : "Publicado"}
      badgeTone={customPage.isDraft ? "amber" : "emerald"}
    />
    <CustomPageEditor customPage={customPage} client:only="preact" />
  </div>
</AdminLayout>
