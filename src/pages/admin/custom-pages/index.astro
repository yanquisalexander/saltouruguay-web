---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import CustomPagesManager from "@/components/admin/CustomPagesManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout
  title="CMS Páginas"
  session={session}
  description="Gestor de contenido estático y páginas personalizadas del sitio"
>
  <div class="space-y-6">
    <AdminPageHeader
      title="CMS de Páginas"
      description="Crea, edita y publica artículos, reglamentos y páginas informativas independientes con editor visual por bloques."
      pathname="/admin/custom-pages"
      badge="Editor CMS"
      badgeTone="violet"
    />
    <CustomPagesManager client:idle />
  </div>
</AdminLayout>
