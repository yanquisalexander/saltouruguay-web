---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import UsersManager from "@/components/admin/UsersManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout title="Usuarios" session={session}>
  <div class="flex flex-col w-full max-w-6xl mx-auto space-y-6">
    <AdminPageHeader
      title="Gestión de Usuarios"
      description="Administra los permisos, roles e información de los miembros registrados."
      pathname="/admin/usuarios"
    />
    <UsersManager client:idle />
  </div>
</AdminLayout>
