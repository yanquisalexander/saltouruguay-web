---
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import UsersManager from "@/components/admin/UsersManager";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, {
    status: 404,
  });
}
---

<AdminLayout
  title="Usuarios"
  session={session}
  description="Directorio de miembros y permisos de la comunidad"
>
  <div class="space-y-6">
    <AdminPageHeader
      title="Gestión de Usuarios"
      description="Supervisa los usuarios registrados, consulta correos y verifica roles de acceso."
      pathname="/admin/usuarios"
      badge="Comunidad"
      badgeTone="violet"
    />
    <UsersManager client:idle />
  </div>
</AdminLayout>
