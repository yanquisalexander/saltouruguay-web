---
import AdminLayout from '@/layouts/AdminLayout.astro';
import TournamentWorkspace from '@/components/tournaments/TournamentWorkspace';

import { client as db } from '@/db/client';
import { TournamentsTable, UsersTable } from '@/db/schema';
import { eq, inArray } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';
import { checkAdmin } from '@/lib/checkAdmin';
import { readCompetition } from '@/lib/tournament-legacy';
const session = await getSession(Astro.request);
const denied = await checkAdmin(session);
if (denied) return denied;
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return Astro.redirect('/admin/torneos');
const tournament = await db.query.TournamentsTable.findFirst({ where: eq(TournamentsTable.id, id), with: { participants: { with: { user: { columns: { displayName: true, username: true } } } }, matches: true } });
if (!tournament) return Astro.redirect('/admin/torneos');
const { competition, format } = readCompetition(tournament);
const userIds = competition.entrants.flatMap(p => p.userId ? [p.userId] : []);
const profiles = userIds.length ? await db.select({ id: UsersTable.id, username: UsersTable.username, displayName: UsersTable.displayName, avatar: UsersTable.avatar }).from(UsersTable).where(inArray(UsersTable.id, userIds)) : [];
---
<AdminLayout title={tournament.name} session={session}><TournamentWorkspace client:load tournament={{ ...tournament, format }} competition={competition} profiles={profiles} canManage currentUserId={Number(session?.user?.id)} /></AdminLayout>

