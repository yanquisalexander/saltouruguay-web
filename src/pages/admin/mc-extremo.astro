---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminExtremoPlayers from "@/components/admin/AdminExtremoPlayers.tsx";
import { client } from "@/db/client";
import { SaltoCraftExtremo3InscriptionsTable } from "@/db/schema";
import { getSession } from "auth-astro/server";
import { desc } from "drizzle-orm";
import {
  LucideUsers,
  LucideUserCheck,
  LucideUserX,
  LucideRefreshCw,
  LucideTrash2,
  LucideGamepad2,
  LucideEye,
  LucideSwords,
  LucideHistory,
  LucideServer,
  LucideSave,
} from "lucide-preact";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, { status: 404 });
}

const inscriptos =
  await client.query.SaltoCraftExtremo3InscriptionsTable.findMany({
    orderBy: desc(SaltoCraftExtremo3InscriptionsTable.createdAt),
    with: {
      user: {
        columns: {
          id: true,
          email: true,
          displayName: true,
          avatar: true,
        },
      },
    },
  });

const totalInsc = inscriptos.length;
const conMinecraft = inscriptos.filter((i) => i.minecraft_username).length;
const sinMinecraft = totalInsc - conMinecraft;
const participaron = inscriptos.filter((i) => i.participated_sc === "si").length;

const kpis = [
  { label: "Total inscriptos", value: totalInsc, icon: LucideUsers, iconClass: "text-sky-300", chipClass: "bg-sky-500/15 border-sky-400/25" },
  { label: "Con Minecraft", value: conMinecraft, icon: LucideUserCheck, iconClass: "text-emerald-300", chipClass: "bg-emerald-500/15 border-emerald-400/25" },
  { label: "Sin Minecraft", value: sinMinecraft, icon: LucideUserX, iconClass: "text-amber-300", chipClass: "bg-amber-500/15 border-amber-400/25" },
  { label: "Jugaron SC previo", value: participaron, icon: LucideHistory, iconClass: "text-violet-300", chipClass: "bg-violet-500/15 border-violet-400/25" },
];
---

<AdminLayout title="MC Extremo" description="Gestión de inscriptos de SaltoCraft Extremo 3" session={session}>
  <div class="space-y-6">
    {/* Header de página */}
    <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
      <div class="min-w-0">
        <p class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-violet-300/80 bg-violet-500/10 border border-violet-400/25 rounded-full px-3 py-1 mb-3">
          <LucideSwords size={12} /> SaltoCraft · Extremo 3
        </p>
        <h2 class="font-anton text-3xl sm:text-4xl text-white uppercase leading-none flex items-center gap-3">
          <span class="size-11 rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-950/50 border border-violet-300/30 shrink-0">
            <LucideGamepad2 size={22} className="text-white" />
          </span>
          Gestión de jugadores
        </h2>
        <p class="text-sm text-white/40 mt-2">
          Sincronizá inscripciones, confirmá participantes y administrá vidas.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button
          id="preview-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white/80 hover:text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer"
        >
          <LucideEye size={15} />
          Preview
        </button>
        <button
          id="sync-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 hover:brightness-110 text-white text-xs font-bold uppercase tracking-wider transition-all shadow-lg shadow-violet-950/50 border border-violet-300/25 cursor-pointer"
        >
          <LucideRefreshCw size={15} />
          Sincronizar
        </button>
        <button
          id="clear-sync-btn"
          title="Eliminar inscripciones locales y sincronizar desde cero"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-red-500/10 hover:bg-red-500 border border-red-500/25 hover:border-red-500 text-red-300 hover:text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer"
        >
          <LucideTrash2 size={15} />
          Limpiar y sincronizar
        </button>
      </div>
    </div>

    {/* KPI strip */}
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-2.5">
      {kpis.map((kpi) => (
        <div class="rounded-2xl bg-white/[0.04] border border-white/[0.07] hover:border-white/15 transition-colors px-4 py-3.5 flex items-center gap-3">
          <span class={`size-10 rounded-xl border flex items-center justify-center shrink-0 ${kpi.chipClass}`}>
            <kpi.icon size={18} class={kpi.iconClass} />
          </span>
          <div class="min-w-0">
            <dt class="text-[10px] font-bold uppercase tracking-widest text-white/40 truncate">{kpi.label}</dt>
            <dd class="text-2xl font-anton text-white leading-none mt-0.5 tabular-nums">{kpi.value}</dd>
          </div>
        </div>
      ))}
    </dl>

    {/* Status message */}
    <div id="sync-status" class="hidden rounded-2xl border text-sm font-rubik px-4 py-3.5"></div>

    {/* DNS SRV — Cloudflare */}
    <section class="relative rounded-3xl border border-white/10 bg-zinc-950/60 backdrop-blur-xl shadow-xl overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-emerald-400/30 to-transparent pointer-events-none"></div>
      <div class="px-5 sm:px-6 py-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-3 min-w-0">
            <span class="size-10 rounded-xl bg-emerald-500/15 border border-emerald-400/25 flex items-center justify-center shrink-0">
              <LucideServer size={18} class="text-emerald-300" />
            </span>
            <div class="min-w-0">
              <h3 class="font-anton text-lg text-white uppercase tracking-wide leading-none">DNS SRV · Extremo</h3>
              <p class="text-xs text-white/40 mt-1 font-mono truncate">_minecraft._tcp.extremo.play.saltouruguayserver.com · TTL 60s</p>
            </div>
          </div>
          <button
            id="srv-refresh-btn"
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white/80 hover:text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer shrink-0"
          >
            <LucideRefreshCw size={14} />
            Actualizar
          </button>
        </div>

        <div id="srv-status" class="hidden rounded-2xl border text-sm font-rubik px-4 py-3 mb-4"></div>

        <div class="rounded-2xl bg-black/40 border border-white/10 px-4 py-3.5 mb-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-sm">
          <span class="text-[11px] font-bold uppercase tracking-widest text-white/40 shrink-0">Actual</span>
          <span id="srv-current" class="font-mono text-emerald-200 truncate">Cargando…</span>
          <span id="srv-meta" class="text-xs text-white/40 font-rubik sm:ml-auto shrink-0"></span>
        </div>

        <form id="srv-form" class="grid grid-cols-1 sm:grid-cols-[1fr_160px_auto] gap-2.5">
          <label class="block">
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/40">Target</span>
            <input
              id="srv-target"
              type="text"
              placeholder="ej: br pools.host.com"
              autocomplete="off"
              spellcheck={false}
              class="mt-1.5 w-full rounded-xl bg-white/5 border border-white/10 focus:border-emerald-400/50 focus:bg-white/[0.07] outline-none px-3.5 py-2.5 text-sm font-mono text-white placeholder:text-white/25 transition-colors"
            />
          </label>
          <label class="block">
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/40">Puerto</span>
            <input
              id="srv-port"
              type="number"
              min="1"
              max="65535"
              placeholder="25565"
              class="mt-1.5 w-full rounded-xl bg-white/5 border border-white/10 focus:border-emerald-400/50 focus:bg-white/[0.07] outline-none px-3.5 py-2.5 text-sm font-mono text-white placeholder:text-white/25 transition-colors"
            />
          </label>
          <div class="flex items-end">
            <button
              type="submit"
              id="srv-save-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:brightness-110 text-white text-xs font-bold uppercase tracking-wider transition-all shadow-lg shadow-emerald-950/50 border border-emerald-300/25 cursor-pointer"
            >
              <LucideSave size={15} />
              Guardar
            </button>
          </div>
        </form>
        <p class="text-[11px] text-white/30 font-rubik mt-3">Priority y weight se conservan. TTL fijo en 60s para propagación rápida. El cambio redirige a los jugadores al próximo ping del server.</p>
      </div>
    </section>

    {/* Player Management */}
    <section class="relative rounded-3xl border border-white/10 bg-zinc-950/60 backdrop-blur-xl shadow-xl overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-violet-400/30 to-transparent pointer-events-none"></div>
      <AdminExtremoPlayers client:idle />
    </section>
  </div>

  {/* Dry Run Modal */}
  <dialog id="dry-run-modal" class="backdrop:bg-black/80 backdrop:backdrop-blur-sm bg-transparent p-4 m-auto w-full max-w-4xl">
    <div class="bg-[#131318] border border-white/10 rounded-3xl overflow-hidden shadow-2xl w-full max-h-[80vh] flex flex-col">
      <div class="px-6 py-4 border-b border-white/10 bg-white/[0.03] flex justify-between items-center shrink-0">
        <div>
          <h3 class="font-anton text-lg text-white uppercase tracking-wide leading-none">Preview de sincronización</h3>
          <p class="text-xs text-white/40 mt-1">Inscripciones que se importarán al sincronizar</p>
        </div>
        <button id="close-modal-btn" aria-label="Cerrar" class="size-9 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white/50 hover:text-white transition-all flex items-center justify-center cursor-pointer">
          ✕
        </button>
      </div>
      <div class="p-6 overflow-auto flex-1">
        <div id="dry-run-loading" class="hidden text-center py-8 text-white/40">
          <LucideRefreshCw className="w-8 h-8 mx-auto mb-3 animate-spin" />
          <p class="font-rubik text-sm">Cargando preview...</p>
        </div>
        <div id="dry-run-content" class="hidden">
          <div class="mb-4 flex items-center gap-3 text-sm font-rubik">
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/40">Total a sincronizar</span>
            <span id="dry-run-count" class="text-2xl font-anton text-white tabular-nums">0</span>
          </div>
          <div class="bg-black/40 border border-white/10 rounded-2xl overflow-hidden overflow-x-auto">
            <table class="w-full min-w-[640px] text-left border-collapse text-sm">
              <thead>
                <tr class="bg-white/5 border-b border-white/10 text-white/40 text-[11px] uppercase tracking-widest">
                  <th class="px-4 py-2.5 font-bold">UserId</th>
                  <th class="px-4 py-2.5 font-bold">Nombre</th>
                  <th class="px-4 py-2.5 font-bold">Discord</th>
                  <th class="px-4 py-2.5 font-bold">Minecraft</th>
                  <th class="px-4 py-2.5 font-bold">Fecha</th>
                </tr>
              </thead>
              <tbody id="dry-run-table" class="divide-y divide-white/5"></tbody>
            </table>
          </div>
        </div>
        <div id="dry-run-error" class="hidden text-center py-8 text-red-400 font-rubik text-sm"></div>
      </div>
      <div class="px-6 py-4 border-t border-white/10 bg-white/[0.02] flex justify-end gap-2 shrink-0">
        <button id="modal-cancel-btn" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white/70 hover:text-white rounded-xl font-bold transition-all text-xs uppercase tracking-wider cursor-pointer">
          Cerrar
        </button>
        <button id="modal-sync-btn" class="px-4 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 hover:brightness-110 text-white rounded-xl font-bold flex items-center gap-2 transition-all text-xs uppercase tracking-wider shadow-lg shadow-violet-950/50 border border-violet-300/25 cursor-pointer">
          <LucideRefreshCw className="w-4 h-4" />
          Sincronizar ahora
        </button>
      </div>
    </div>
  </dialog>

  <script>
    const syncBtn = document.getElementById("sync-btn");
    const clearSyncBtn = document.getElementById("clear-sync-btn");
    const previewBtn = document.getElementById("preview-btn");
    const statusDiv = document.getElementById("sync-status");
    const modal = document.getElementById("dry-run-modal") as HTMLDialogElement;
    const closeModalBtn = document.getElementById("close-modal-btn");
    const modalCancelBtn = document.getElementById("modal-cancel-btn");
    const modalSyncBtn = document.getElementById("modal-sync-btn");
    const dryRunLoading = document.getElementById("dry-run-loading");
    const dryRunContent = document.getElementById("dry-run-content");
    const dryRunError = document.getElementById("dry-run-error");
    const dryRunCount = document.getElementById("dry-run-count");
    const dryRunTable = document.getElementById("dry-run-table");

    function showStatus(type: "loading" | "success" | "error", message: string) {
      if (!statusDiv) return;
      statusDiv.classList.remove("hidden");
      statusDiv.className = `rounded-2xl border text-sm font-rubik px-4 py-3.5 flex items-center gap-2.5 ${
        type === "loading"
          ? "bg-violet-500/10 border-violet-400/25 text-violet-200"
          : type === "success"
            ? "bg-emerald-500/10 border-emerald-400/25 text-emerald-200"
            : "bg-red-500/10 border-red-500/25 text-red-200"
      }`;
      statusDiv.textContent = message;
    }

    async function doSync(clear: boolean) {
      showStatus("loading", clear ? "Limpiando y sincronizando..." : "Sincronizando...");
      modal?.close();
      try {
        const res = await fetch("/api/admin/sync-extremo", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ clear }),
        });
        const data = await res.json();
        if (data.success) {
          showStatus("success", data.message);
          setTimeout(() => location.reload(), 1500);
        } else {
          showStatus("error", data.error || "Error al sincronizar");
        }
      } catch {
        showStatus("error", "Error de conexión");
      }
    }

    async function showDryRun() {
      modal?.showModal();
      dryRunLoading?.classList.remove("hidden");
      dryRunContent?.classList.add("hidden");
      dryRunError?.classList.add("hidden");

      try {
        const res = await fetch("/api/admin/sync-extremo");
        const data = await res.json();

        dryRunLoading?.classList.add("hidden");

        if (!data.success) {
          dryRunError?.classList.remove("hidden");
          dryRunError!.textContent = data.error || "Error al obtener preview";
          return;
        }

        dryRunContent?.classList.remove("hidden");
        dryRunCount!.textContent = data.total;

        dryRunTable!.innerHTML = data.inscriptions.map((insc: any) => `
          <tr class="hover:bg-white/5 transition-colors">
            <td class="px-4 py-2.5 text-white/30 font-mono text-xs">${insc.userId}</td>
            <td class="px-4 py-2.5 text-white font-rubik">${insc.displayName}</td>
            <td class="px-4 py-2.5 text-white/60 font-rubik">${insc.discordUsername || '—'}</td>
            <td class="px-4 py-2.5 text-white font-minecraftia">${insc.minecraft_username || '—'}</td>
            <td class="px-4 py-2.5 text-white/40 font-mono text-xs">${new Date(insc.createdAt).toLocaleDateString('es-UY')}</td>
          </tr>
        `).join("");
      } catch {
        dryRunLoading?.classList.add("hidden");
        dryRunError?.classList.remove("hidden");
        dryRunError!.textContent = "Error de conexión al obtener preview";
      }
    }

    syncBtn?.addEventListener("click", () => doSync(false));
    clearSyncBtn?.addEventListener("click", () => {
      if (confirm("¿Eliminar todas las inscripciones locales y sincronizar desde cero?")) {
        doSync(true);
      }
    });
    previewBtn?.addEventListener("click", showDryRun);
    closeModalBtn?.addEventListener("click", () => modal?.close());
    modalCancelBtn?.addEventListener("click", () => modal?.close());
    modalSyncBtn?.addEventListener("click", () => doSync(false));
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal?.close();
    });

    // --- DNS SRV (Cloudflare) ---
    const srvForm = document.getElementById("srv-form");
    const srvRefreshBtn = document.getElementById("srv-refresh-btn");
    const srvSaveBtn = document.getElementById("srv-save-btn") as HTMLButtonElement | null;
    const srvStatus = document.getElementById("srv-status");
    const srvCurrent = document.getElementById("srv-current");
    const srvMeta = document.getElementById("srv-meta");
    const srvTargetInput = document.getElementById("srv-target") as HTMLInputElement | null;
    const srvPortInput = document.getElementById("srv-port") as HTMLInputElement | null;

    function showSrvStatus(type: "loading" | "success" | "error", message: string) {
      if (!srvStatus) return;
      srvStatus.classList.remove("hidden");
      srvStatus.className = `rounded-2xl border text-sm font-rubik px-4 py-3 mb-4 ${
        type === "loading"
          ? "bg-emerald-500/10 border-emerald-400/25 text-emerald-200"
          : type === "success"
            ? "bg-emerald-500/10 border-emerald-400/25 text-emerald-200"
            : "bg-red-500/10 border-red-500/25 text-red-200"
      }`;
      srvStatus.textContent = message;
    }

    function renderSrv(record: any) {
      if (srvCurrent) srvCurrent.textContent = `${record.target}:${record.port}`;
      if (srvMeta) srvMeta.textContent = `prio ${record.priority} · peso ${record.weight} · TTL ${record.ttl}s`;
      if (srvTargetInput) srvTargetInput.value = record.target ?? "";
      if (srvPortInput) srvPortInput.value = String(record.port ?? "");
    }

    async function loadSrv() {
      showSrvStatus("loading", "Obteniendo registro SRV…");
      try {
        const res = await fetch("/api/admin/mc-srv");
        const data = await res.json();
        if (!data.success) {
          if (srvCurrent) srvCurrent.textContent = "—";
          showSrvStatus("error", data.error || "Error al obtener el SRV");
          return;
        }
        renderSrv(data.record);
        srvStatus?.classList.add("hidden");
      } catch {
        if (srvCurrent) srvCurrent.textContent = "—";
        showSrvStatus("error", "Error de conexión con Cloudflare");
      }
    }

    srvRefreshBtn?.addEventListener("click", loadSrv);

    srvForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const target = srvTargetInput?.value.trim() ?? "";
      const port = Number(srvPortInput?.value);
      if (!target || !Number.isInteger(port) || port < 1 || port > 65535) {
        showSrvStatus("error", "Target y puerto válido (1–65535) requeridos");
        return;
      }
      if (!confirm(`¿Apuntar el SRV a ${target}:${port}? Los jugadores se redirigen al próximo ping.`)) return;
      if (srvSaveBtn) {
        srvSaveBtn.disabled = true;
        srvSaveBtn.classList.add("opacity-50", "pointer-events-none");
      }
      showSrvStatus("loading", `Actualizando SRV a ${target}:${port}…`);
      try {
        const res = await fetch("/api/admin/mc-srv", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ target, port }),
        });
        const data = await res.json();
        if (data.success) {
          renderSrv(data.record);
          showSrvStatus("success", `SRV actualizado: ${data.record.target}:${data.record.port} (TTL ${data.record.ttl}s)`);
        } else {
          showSrvStatus("error", data.error || "Error al actualizar");
        }
      } catch {
        showSrvStatus("error", "Error de conexión");
      } finally {
        if (srvSaveBtn) {
          srvSaveBtn.disabled = false;
          srvSaveBtn.classList.remove("opacity-50", "pointer-events-none");
        }
      }
    });

    loadSrv();
  </script>
</AdminLayout>
