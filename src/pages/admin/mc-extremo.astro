---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminExtremoPlayers from "@/components/admin/AdminExtremoPlayers.tsx";
import { client } from "@/db/client";
import { SaltoCraftExtremo3InscriptionsTable } from "@/db/schema";
import { getSession } from "auth-astro/server";
import { desc } from "drizzle-orm";
import {
  LucideUsers,
  LucideUserCheck,
  LucideUserX,
  LucideRefreshCw,
  LucideTrash2,
  LucideGamepad2,
  LucideEye,
} from "lucide-preact";

const session = await getSession(Astro.request);

if (!session?.user.isAdmin) {
  return new Response(null, { status: 404 });
}

const inscriptos =
  await client.query.SaltoCraftExtremo3InscriptionsTable.findMany({
    orderBy: desc(SaltoCraftExtremo3InscriptionsTable.createdAt),
    with: {
      user: {
        columns: {
          id: true,
          email: true,
          displayName: true,
          avatar: true,
        },
      },
    },
  });

const totalInsc = inscriptos.length;
const conMinecraft = inscriptos.filter((i) => i.minecraft_username).length;
const sinMinecraft = totalInsc - conMinecraft;
const participaron = inscriptos.filter((i) => i.participated_sc === "si").length;

const cardBase =
  "relative overflow-hidden bg-[#0a0a0a] border border-white/5 rounded-2xl p-6 shadow-xl backdrop-blur-xs";
---

<AdminLayout title="Extremo 3 - Gestión" session={session}>
  <div class="flex flex-col max-w-6xl mx-auto min-h-screen mt-16 p-6">
    {/* Header */}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white font-anton flex items-center gap-3">
          <LucideGamepad2 className="w-8 h-8 text-electric-violet-400" />
          SaltoCraft Extremo 3
        </h1>
        <p class="text-gray-400 font-rubik mt-1">
          Gestión de jugadores inscriptos
        </p>
      </div>
      <div class="flex gap-3">
        <button
          id="preview-btn"
          class="px-4 py-2 bg-white/10 hover:bg-white/15 text-white rounded-lg font-bold flex items-center gap-2 transition-colors text-sm border border-white/10"
        >
          <LucideEye className="w-4 h-4" />
          Preview
        </button>
        <button
          id="sync-btn"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-bold flex items-center gap-2 transition-colors text-sm"
        >
          <LucideRefreshCw className="w-4 h-4" />
          Sincronizar
        </button>
        <button
          id="clear-sync-btn"
          class="px-4 py-2 bg-red-600/80 hover:bg-red-500 text-white rounded-lg font-bold flex items-center gap-2 transition-colors text-sm"
        >
          <LucideTrash2 className="w-4 h-4" />
          Limpiar y Sincronizar
        </button>
      </div>
    </div>

    {/* KPI Cards */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class={cardBase}>
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 rounded-xl bg-blue-500/10 border border-blue-500/20">
            <LucideUsers className="w-5 h-5 text-blue-400" />
          </div>
        </div>
        <p class="text-white/50 text-xs font-bold uppercase tracking-widest font-rubik">
          Total
        </p>
        <p class="text-3xl font-anton text-white mt-1">{totalInsc}</p>
      </div>

      <div class={cardBase}>
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 rounded-xl bg-green-500/10 border border-green-500/20">
            <LucideUserCheck className="w-5 h-5 text-green-400" />
          </div>
        </div>
        <p class="text-white/50 text-xs font-bold uppercase tracking-widest font-rubik">
          Con MC
        </p>
        <p class="text-3xl font-anton text-green-400 mt-1">{conMinecraft}</p>
      </div>

      <div class={cardBase}>
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 rounded-xl bg-yellow-500/10 border border-yellow-500/20">
            <LucideUserX className="w-5 h-5 text-yellow-400" />
          </div>
        </div>
        <p class="text-white/50 text-xs font-bold uppercase tracking-widest font-rubik">
          Sin MC
        </p>
        <p class="text-3xl font-anton text-yellow-400 mt-1">{sinMinecraft}</p>
      </div>

      <div class={cardBase}>
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 rounded-xl bg-purple-500/10 border border-purple-500/20">
            <LucideUsers className="w-5 h-5 text-purple-400" />
          </div>
        </div>
        <p class="text-white/50 text-xs font-bold uppercase tracking-widest font-rubik">
          Repetidos
        </p>
        <p class="text-3xl font-anton text-purple-400 mt-1">{participaron}</p>
      </div>
    </div>

    {/* Status message */}
    <div id="sync-status" class="hidden mb-6 p-4 rounded-lg border text-sm font-rubik"></div>

    {/* Player Management */}
    <AdminExtremoPlayers client:idle />
  </div>

  {/* Dry Run Modal */}
  <dialog id="dry-run-modal" class="backdrop:bg-black/80 backdrop:backdrop-blur-xs bg-transparent p-4">
    <div class="bg-linear-to-br from-gray-900 via-gray-900 to-black border border-white/10 rounded-2xl overflow-hidden shadow-2xl w-full max-w-4xl max-h-[80vh] flex flex-col m-auto">
      <div class="px-6 py-4 border-b border-white/10 bg-white/5 flex justify-between items-center">
        <h3 class="font-anton text-lg text-white">Preview de Sincronización</h3>
        <button id="close-modal-btn" class="text-gray-400 hover:text-white transition-colors p-1">
          ✕
        </button>
      </div>
      <div class="p-6 overflow-auto flex-1">
        <div id="dry-run-loading" class="hidden text-center py-8 text-gray-400">
          <LucideRefreshCw className="w-8 h-8 mx-auto mb-3 animate-spin" />
          <p class="font-rubik">Cargando preview...</p>
        </div>
        <div id="dry-run-content" class="hidden">
          <div class="mb-4 flex items-center gap-4 text-sm font-rubik">
            <span class="text-gray-400">Total a sincronizar:</span>
            <span id="dry-run-count" class="text-2xl font-anton text-white">0</span>
          </div>
          <div class="bg-[#1a1b1e] border border-white/10 rounded-xl overflow-hidden">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-white/5 border-b border-white/10 text-gray-400 text-xs uppercase tracking-wider">
                  <th class="px-4 py-2 font-medium">UserId</th>
                  <th class="px-4 py-2 font-medium">Nombre</th>
                  <th class="px-4 py-2 font-medium">Discord</th>
                  <th class="px-4 py-2 font-medium">Minecraft</th>
                  <th class="px-4 py-2 font-medium">Fecha</th>
                </tr>
              </thead>
              <tbody id="dry-run-table" class="divide-y divide-white/5"></tbody>
            </table>
          </div>
        </div>
        <div id="dry-run-error" class="hidden text-center py-8 text-red-400 font-rubik"></div>
      </div>
      <div class="px-6 py-4 border-t border-white/10 bg-white/5 flex justify-end gap-3">
        <button id="modal-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/15 text-white rounded-lg font-bold transition-colors text-sm">
          Cerrar
        </button>
        <button id="modal-sync-btn" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-bold flex items-center gap-2 transition-colors text-sm">
          <LucideRefreshCw className="w-4 h-4" />
          Sincronizar Ahora
        </button>
      </div>
    </div>
  </dialog>

  <script>
    const syncBtn = document.getElementById("sync-btn");
    const clearSyncBtn = document.getElementById("clear-sync-btn");
    const previewBtn = document.getElementById("preview-btn");
    const statusDiv = document.getElementById("sync-status");
    const modal = document.getElementById("dry-run-modal") as HTMLDialogElement;
    const closeModalBtn = document.getElementById("close-modal-btn");
    const modalCancelBtn = document.getElementById("modal-cancel-btn");
    const modalSyncBtn = document.getElementById("modal-sync-btn");
    const dryRunLoading = document.getElementById("dry-run-loading");
    const dryRunContent = document.getElementById("dry-run-content");
    const dryRunError = document.getElementById("dry-run-error");
    const dryRunCount = document.getElementById("dry-run-count");
    const dryRunTable = document.getElementById("dry-run-table");

    function showStatus(type: "loading" | "success" | "error", message: string) {
      if (!statusDiv) return;
      statusDiv.classList.remove("hidden");
      statusDiv.className = `mb-6 p-4 rounded-lg border text-sm font-rubik ${
        type === "loading"
          ? "bg-blue-500/10 border-blue-500/20 text-blue-400"
          : type === "success"
            ? "bg-green-500/10 border-green-500/20 text-green-400"
            : "bg-red-500/10 border-red-500/20 text-red-400"
      }`;
      statusDiv.textContent = message;
    }

    async function doSync(clear: boolean) {
      showStatus("loading", clear ? "Limpiando y sincronizando..." : "Sincronizando...");
      modal?.close();
      try {
        const res = await fetch("/api/admin/sync-extremo", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ clear }),
        });
        const data = await res.json();
        if (data.success) {
          showStatus("success", data.message);
          setTimeout(() => location.reload(), 1500);
        } else {
          showStatus("error", data.error || "Error al sincronizar");
        }
      } catch {
        showStatus("error", "Error de conexión");
      }
    }

    async function showDryRun() {
      modal?.showModal();
      dryRunLoading?.classList.remove("hidden");
      dryRunContent?.classList.add("hidden");
      dryRunError?.classList.add("hidden");

      try {
        const res = await fetch("/api/admin/sync-extremo");
        const data = await res.json();

        dryRunLoading?.classList.add("hidden");

        if (!data.success) {
          dryRunError?.classList.remove("hidden");
          dryRunError!.textContent = data.error || "Error al obtener preview";
          return;
        }

        dryRunContent?.classList.remove("hidden");
        dryRunCount!.textContent = data.total;

        dryRunTable!.innerHTML = data.inscriptions.map((insc: any) => `
          <tr class="hover:bg-white/5 transition-colors">
            <td class="px-4 py-2 text-gray-500 font-mono">${insc.userId}</td>
            <td class="px-4 py-2 text-white font-rubik">${insc.displayName}</td>
            <td class="px-4 py-2 text-gray-300 font-rubik">${insc.discordUsername || '—'}</td>
            <td class="px-4 py-2 text-white font-minecraftia">${insc.minecraft_username || '—'}</td>
            <td class="px-4 py-2 text-gray-400 font-mono text-xs">${new Date(insc.createdAt).toLocaleDateString('es-UY')}</td>
          </tr>
        `).join("");
      } catch {
        dryRunLoading?.classList.add("hidden");
        dryRunError?.classList.remove("hidden");
        dryRunError!.textContent = "Error de conexión al obtener preview";
      }
    }

    syncBtn?.addEventListener("click", () => doSync(false));
    clearSyncBtn?.addEventListener("click", () => {
      if (confirm("¿Eliminar todas las inscripciones locales y sincronizar desde cero?")) {
        doSync(true);
      }
    });
    previewBtn?.addEventListener("click", showDryRun);
    closeModalBtn?.addEventListener("click", () => modal?.close());
    modalCancelBtn?.addEventListener("click", () => modal?.close());
    modalSyncBtn?.addEventListener("click", () => doSync(false));
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal?.close();
    });
  </script>
</AdminLayout>
