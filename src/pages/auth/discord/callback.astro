---
import Layout from "@/layouts/Layout.astro";
import { getSession } from "auth-astro/server";
import { getProvider, getLinkedAccountByProviderId, createLinkedAccount, updateLinkedAccount } from "@/lib/linked-accounts";
import {
  LucideLoader2,
  LucideCheckCircle2,
  LucideAlertTriangle,
  LucideLink,
  LucideXCircle,
} from "lucide-preact";

const url = new URL(Astro.request.url);
const code = url.searchParams.get("code");
const state = url.searchParams.get("state");
const session = await getSession(Astro.request);

const provider = getProvider("discord");

const LINK_ERRORS = {
  USER_IS_NOT_MEMBER: "USER_IS_NOT_MEMBER",
  ACCOUNT_ALREADY_LINKED: "ACCOUNT_ALREADY_LINKED",
  GENERIC: "GENERIC_ERROR",
};

let result: { error?: boolean; code?: string; message?: string; success?: boolean; username?: string } = {};

if (!session || !provider || !code) {
  result = { error: true, code: LINK_ERRORS.GENERIC, message: "Sesión inválida" };
} else {
  const cookieState = Astro.cookies.get("linked_account_state")?.value;
  if (state && cookieState && state !== cookieState) {
    result = { error: true, code: LINK_ERRORS.GENERIC, message: "State inválido" };
  } else {
    Astro.cookies.delete("linked_account_state", { path: "/" });

    try {
      const baseUrl = url.origin;
      const callbackUrl = `${baseUrl}/api/linked-accounts/discord/callback`;
      const userData = await provider.handleCallback(code, callbackUrl);

      const existingAccount = await getLinkedAccountByProviderId("discord", userData.providerUserId);

      if (existingAccount && existingAccount.userId !== session.user.id) {
        result = { error: true, code: LINK_ERRORS.ACCOUNT_ALREADY_LINKED };
      } else {
        if (existingAccount && existingAccount.userId === session.user.id) {
          await updateLinkedAccount(existingAccount.id, {
            username: userData.username,
            avatar: userData.avatar,
            accessToken: userData.accessToken,
            refreshToken: userData.refreshToken,
            tokenExpiresAt: userData.expiresAt,
            scopes: userData.scopes,
          });
        } else {
          await createLinkedAccount({
            userId: session.user.id,
            provider: "discord",
            providerUserId: userData.providerUserId,
            username: userData.username,
            avatar: userData.avatar,
            accessToken: userData.accessToken,
            refreshToken: userData.refreshToken,
            tokenExpiresAt: userData.expiresAt,
            scopes: userData.scopes,
          });
        }
        result = { success: true, username: userData.username ?? undefined };
      }
    } catch (e) {
      if (e instanceof Error && e.message === "USER_IS_NOT_MEMBER") {
        result = { error: true, code: LINK_ERRORS.USER_IS_NOT_MEMBER };
      } else {
        result = { error: true, code: LINK_ERRORS.GENERIC, message: e instanceof Error ? e.message : "Error interno" };
      }
    }
  }
}

const discordUrl = "https://discord.gg/saltouruguay";
---

<Layout
  title={result.success ? "¡Discord Vinculado!" : "Vinculando Discord..."}
  hideHeader
  hideFooter
  mainClassname="m-0 p-0 min-h-dvh"
>
  <div class="fixed inset-0 -z-10 bg-[#050505]">
    <div class="absolute inset-0 bg-[url('/images/pattern-grid.svg')] opacity-[0.03]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#5865F2]/10 blur-[120px] rounded-full pointer-events-none"></div>
  </div>

  <div class="flex items-center justify-center min-h-dvh p-4">
    <div class="w-full max-w-md animate-in fade-in zoom-in-95 duration-500">
      {/* ÉXITO */}
      {result.success && (
        <div class="bg-[#0a0a0a] border border-green-500/20 rounded-2xl p-8 text-center shadow-2xl shadow-green-900/20">
          <div class="inline-flex p-4 bg-green-500/10 rounded-full text-green-500 mb-6 border border-green-500/20">
            <LucideCheckCircle2 size={48} />
          </div>
          <h1 class="text-2xl font-anton text-white uppercase tracking-wide mb-2">
            ¡Discord Vinculado!
          </h1>
          <p class="text-white/60 font-rubik text-sm mb-6">
            {result.username ? `Conectado como ${result.username}` : "Tu cuenta de Discord fue conectada correctamente."}
          </p>
          <LucideLoader2 size={24} class="animate-spin mx-auto text-white/30" />
        </div>
      )}

      {/* USUARIO NO ES MIEMBRO */}
      {result.error && result.code === LINK_ERRORS.USER_IS_NOT_MEMBER && (
        <div class="bg-[#0a0a0a] border border-yellow-500/20 rounded-2xl p-8 text-center shadow-2xl">
          <div class="inline-flex p-4 bg-yellow-500/10 rounded-full text-yellow-500 mb-6 border border-yellow-500/20">
            <LucideAlertTriangle size={48} />
          </div>
          <h1 class="text-2xl font-anton text-white uppercase tracking-wide mb-2">
            Acceso Restringido
          </h1>
          <p class="text-white/60 font-rubik text-sm mb-6">
            Debes ser miembro de nuestro servidor de Discord para vincular tu cuenta.
          </p>
          <a href={discordUrl} target="_blank"
            class="block w-full py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold rounded-xl transition-colors shadow-lg shadow-indigo-500/20">
            Unirse al Servidor
          </a>
        </div>
      )}

      {/* CUENTA YA VINCULADA A OTRO USUARIO */}
      {result.error && result.code === LINK_ERRORS.ACCOUNT_ALREADY_LINKED && (
        <div class="bg-[#0a0a0a] border border-red-500/20 rounded-2xl p-8 text-center shadow-2xl">
          <div class="inline-flex p-4 bg-red-500/10 rounded-full text-red-500 mb-6 border border-red-500/20">
            <LucideLink size={48} />
          </div>
          <h1 class="text-2xl font-anton text-white uppercase tracking-wide mb-2">
            Cuenta en Uso
          </h1>
          <p class="text-white/60 font-rubik text-sm mb-6">
            Esta cuenta de Discord ya está vinculada a otro perfil.
          </p>
        </div>
      )}

      {/* ERROR GENÉRICO */}
      {result.error && result.code === LINK_ERRORS.GENERIC && (
        <div class="bg-[#0a0a0a] border border-red-500/20 rounded-2xl p-8 text-center shadow-2xl">
          <div class="inline-flex p-4 bg-red-500/10 rounded-full text-red-500 mb-6 border border-red-500/20">
            <LucideXCircle size={48} />
          </div>
          <h1 class="text-2xl font-anton text-white uppercase tracking-wide mb-2">
            Error de Conexión
          </h1>
          <p class="text-white/60 font-rubik text-sm mb-6">
            {result.message || "Ocurrió un error inesperado al intentar vincular."}
          </p>
        </div>
      )}
    </div>
  </div>
</Layout>

<script is:inline
  data-success={result.success ? "1" : "0"}
  data-error={result.error ? "1" : "0"}
  data-username={result.username || ""}
  data-code={result.code || ""}
>
  (function() {
    var s = document.currentScript;
    var isSuccess = s.dataset.success === "1";
    var isError = s.dataset.error === "1";
    var username = s.dataset.username;
    var code = s.dataset.code;

    setTimeout(function() {
      if (window.opener) {
        if (isSuccess) {
          window.opener.dispatchEvent(new CustomEvent("DiscordLinked", { detail: { username: username } }));
        } else if (isError) {
          window.opener.dispatchEvent(new CustomEvent("DiscordLinkError", { detail: { code: code } }));
        }
        window.close();
      } else {
        window.location.href = "/onboarding";
      }
    }, 2000);
  })();
</script>
