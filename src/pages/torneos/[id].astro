---
import Layout from '@/layouts/Layout.astro';
import TournamentWorkspace from '@/components/tournaments/TournamentWorkspace';

import { client as db } from '@/db/client';
import { TournamentsTable, UsersTable } from '@/db/schema';
import { eq, inArray } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';
import { readCompetition } from '@/lib/tournament-legacy';
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return Astro.redirect('/404');
const session = await getSession(Astro.request);
const user = session?.user?.id ? await db.query.UsersTable.findFirst({ where: eq(UsersTable.id, Number(session.user.id)), columns: { id: true, admin: true } }) : null;
const tournament = await db.query.TournamentsTable.findFirst({ where: eq(TournamentsTable.id, id), with: { participants: { with: { user: { columns: { displayName: true, username: true } } } }, matches: true } });
if (!tournament) return Astro.redirect('/404');
if ((tournament.privacy === 'private' || tournament.status === 'draft') && !user?.admin) return Astro.redirect('/404');
const { competition, format } = readCompetition(tournament);
const userIds = competition.entrants.flatMap(p => p.userId ? [p.userId] : []);
const profiles = userIds.length ? await db.select({ id: UsersTable.id, username: UsersTable.username, displayName: UsersTable.displayName, avatar: UsersTable.avatar }).from(UsersTable).where(inArray(UsersTable.id, userIds)) : [];
---
<Layout title={tournament.name} description={tournament.description ?? 'Competencia de la comunidad'} noindex={tournament.privacy === 'private'}>
  <TournamentWorkspace client:load tournament={{ id: tournament.id, name: tournament.name, description: tournament.description, format, status: tournament.status, privacy: tournament.privacy, maxParticipants: tournament.maxParticipants, bannerUrl: tournament.bannerUrl }} competition={competition} profiles={profiles} currentUserId={user?.id} />
</Layout>

