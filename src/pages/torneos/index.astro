---
import Layout from '@/layouts/Layout.astro';
import TournamentHub from '@/components/tournaments/TournamentHub';
import { client as db } from '@/db/client';
import { TournamentsTable } from '@/db/schema';
import { desc, and, eq, ne } from 'drizzle-orm';
import { competitionFrom } from '@/lib/tournament-engine';
const rows = await db.query.TournamentsTable.findMany({
  where: and(eq(TournamentsTable.privacy, 'public'), ne(TournamentsTable.status, 'draft')),
  orderBy: [desc(TournamentsTable.createdAt)],
  with: { participants: { columns: { id: true } } },
});
const tournaments = rows.map(t => ({ id: t.id, name: t.name, description: t.description, format: t.format, status: t.status, privacy: t.privacy, maxParticipants: t.maxParticipants, bannerUrl: t.bannerUrl, count: competitionFrom(t.config)?.entrants.length ?? t.participants.length }));
---
<Layout title="Torneos" description="Seguí las competencias de la comunidad.">
  <TournamentHub client:load tournaments={tournaments} />
</Layout>
