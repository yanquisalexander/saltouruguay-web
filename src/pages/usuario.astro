---
import PageBackdrop from "@/components/PageBackdrop.astro";
import PageBreadcrumb from "@/components/PageBreadcrumb.astro";
import { UserAccountLayout } from "@/components/UsersPage/UserAccountLayout";
import Layout from "@/layouts/Layout.astro";
import { getDiscordUser } from "@/services/discord";
import { getSession } from "auth-astro/server";
import {
  LucideExternalLink,
  LucideLogOut,
  LucideShieldCheck,
  LucideBadgeCheck,
  LucideIdCard,
  LucideCrown,
  LucideSparkles,
  LucideLink2,
  LucideSettings2,
  LucideChevronRight,
} from "lucide-preact";
import { CHRISTMAS_MODE, HALLOWEEN_MODE } from "@/config";
import { NOMINEES } from "@/awards/Nominees";

const session = await getSession(Astro.request);

if (!session) {
  return Astro.redirect("/");
}

const discordAccount = session?.user?.linkedAccounts?.discord;
const discordUser = discordAccount
  ? await getDiscordUser(discordAccount.providerUserId)
  : null;

const isNominated = session.user && NOMINEES[session.user.username as keyof typeof NOMINEES];
const hasTier = Boolean(session.user.tier);
const isAdmin = Boolean(session.user.isAdmin);
const connectedCount = 1 + (discordUser ? 1 : 0);

const bannerGradient = HALLOWEEN_MODE
  ? "from-orange-600 via-fuchsia-700 to-violet-950"
  : CHRISTMAS_MODE
    ? "from-red-700 via-emerald-800 to-zinc-950"
    : "from-violet-700 via-indigo-700 to-cyan-600";

const avatarRing = isNominated
  ? "ring-amber-300 shadow-[0_0_40px_-5px_rgba(251,191,36,0.6)]"
  : "ring-white/20 shadow-[0_0_40px_-10px_rgba(139,92,246,0.6)]";
---

<Layout title="Mi cuenta" mainClassname="p-0">
  <PageBackdrop tone={HALLOWEEN_MODE ? "ember" : CHRISTMAS_MODE ? "festive" : "violet"} />

  <div class="max-w-6xl mx-auto px-4 py-6 md:py-10 mt-14 sm:mt-20">
    <div class="flex items-center justify-between mb-5">
      <PageBreadcrumb
        pathname="/usuario"
        breadcrumbs={[{ text: "Mi cuenta", href: "/usuario" }]}
      />
      <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-widest text-white/40 bg-white/5 border border-white/10 rounded-full px-3 py-1.5">
        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Sesión activa
      </span>
    </div>

    {/* ── HERO DE PERFIL ─────────────────────────────── */}
    <header class="relative overflow-hidden rounded-3xl border border-white/10 bg-zinc-950/80 backdrop-blur-2xl shadow-2xl">
      {/* Banner */}
      <div class={`relative h-32 sm:h-44 bg-gradient-to-r ${bannerGradient}`}>
        <div class="absolute inset-0 bg-[url('/images/pattern-grid.svg')] opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
        {HALLOWEEN_MODE && (
          <span class="absolute top-4 right-6 text-3xl select-none animate-bounce" aria-hidden="true">🎃</span>
        )}
        {CHRISTMAS_MODE && (
          <span class="absolute top-4 right-6 text-3xl select-none" aria-hidden="true">🎄</span>
        )}
        {isNominated && (
          <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-black/50 backdrop-blur-md border border-amber-300/40 text-amber-200 text-[11px] font-bold uppercase tracking-widest rounded-full px-3 py-1.5">
            <LucideSparkles size={13} /> Nominado a los Salto Awards
          </div>
        )}
      </div>

      {/* Identidad */}
      <div class="relative px-5 sm:px-8 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-5 -mt-10 sm:-mt-12">
          <div class="relative shrink-0">
            <img
              src={session.user.image}
              alt={session.user.name}
              class={`size-20 sm:size-24 rounded-2xl object-cover ring-4 ${avatarRing} bg-zinc-900`}
            />
            <span
              class="absolute -bottom-1 -right-1 size-6 rounded-full border-4 border-zinc-950 bg-emerald-500 shadow-[0_0_12px_#10b981]"
              title="Cuenta activa"
            ></span>
          </div>

          <div class="flex-1 min-w-0 sm:pb-1">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              {isAdmin && (
                <span class="inline-flex items-center gap-1 bg-violet-500/15 text-violet-200 border border-violet-400/30 rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider">
                  <LucideShieldCheck size={12} /> Admin
                </span>
              )}
              {hasTier && (
                <span class="inline-flex items-center gap-1 bg-amber-400/15 text-amber-200 border border-amber-300/30 rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider">
                  <LucideCrown size={12} /> Tier {session.user.tier}
                </span>
              )}
              {discordUser && (
                <span class="inline-flex items-center gap-1 bg-[#5865F2]/15 text-indigo-200 border border-indigo-400/30 rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider">
                  <LucideBadgeCheck size={12} /> Discord vinculado
                </span>
              )}
            </div>
            <h1 class="text-2xl sm:text-4xl font-anton text-white uppercase tracking-wide leading-none truncate">
              {session.user.name}
            </h1>
            <p class="text-white/50 font-rubik text-sm mt-1 truncate">{session.user.email}</p>
          </div>

          <div class="flex sm:flex-col lg:flex-row gap-2 shrink-0">
            <a
              href="/comunidad/member-card"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white text-black font-bold text-xs uppercase tracking-wider hover:bg-zinc-200 transition-all shadow-lg"
            >
              <LucideIdCard size={15} /> Member Card
            </a>
            <button
              id="account-logout"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-red-500 text-white/70 hover:text-white font-bold text-xs uppercase tracking-wider transition-all border border-white/10 hover:border-red-500 cursor-pointer"
            >
              <LucideLogOut size={15} /> Salir
            </button>
          </div>
        </div>

        {/* Stats strip */}
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-6">
          <div class="rounded-2xl bg-white/[0.04] border border-white/[0.07] px-4 py-3">
            <dt class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-0.5">Rol</dt>
            <dd class="text-sm font-bold text-white flex items-center gap-1.5">
              {isAdmin ? <><LucideShieldCheck size={14} className="text-violet-300" /> Administrador</> : "Miembro"}
            </dd>
          </div>
          <div class="rounded-2xl bg-white/[0.04] border border-white/[0.07] px-4 py-3">
            <dt class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-0.5">Member ID</dt>
            <dd class="text-sm font-mono font-bold text-white truncate">#{session.user.id}</dd>
          </div>
          <div class="rounded-2xl bg-white/[0.04] border border-white/[0.07] px-4 py-3">
            <dt class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-0.5">Conexiones</dt>
            <dd class="text-sm font-bold text-white flex items-center gap-1.5">
              <LucideLink2 size={14} className="text-cyan-300" /> {connectedCount} de 2
            </dd>
          </div>
          <div class="rounded-2xl bg-white/[0.04] border border-white/[0.07] px-4 py-3">
            <dt class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-0.5">Suscripción</dt>
            <dd class={`text-sm font-bold flex items-center gap-1.5 ${hasTier ? "text-amber-300" : "text-white/50"}`}>
              <LucideCrown size={14} /> {hasTier ? `Tier ${session.user.tier}` : "Sin sub"}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    {/* ── CONTENIDO ──────────────────────────────────── */}
    <div class="grid gap-6 lg:grid-cols-[1fr_330px] mt-6 items-start">
      {/* Panel principal con tabs */}
      <main class="min-w-0 order-2 lg:order-1">
        <UserAccountLayout
          session={session}
          discordUser={discordUser}
          client:idle
        />
      </main>

      {/* Sidebar */}
      <aside class="flex flex-col gap-5 order-1 lg:order-2 lg:sticky lg:top-24">
        {/* Membresía Twitch */}
        <section class="relative overflow-hidden rounded-3xl border border-violet-400/20 bg-gradient-to-b from-violet-950/60 via-[#0d0a1a] to-black p-5 shadow-xl">
          <LucideCrown size={90} class="absolute -right-3 -top-3 text-violet-500/10 rotate-12 pointer-events-none" />
          <h3 class="font-anton text-base text-white uppercase tracking-wide mb-1 flex items-center gap-2">
            <span class="size-7 rounded-lg bg-[#9146FF] flex items-center justify-center shrink-0">
              <img src="/twitch-icon.png" alt="Twitch" class="size-4" />
            </span>
            Membresía Twitch
          </h3>
          <p class={`text-sm font-bold mt-2 ${hasTier ? "text-amber-300" : "text-white/60"}`}>
            {hasTier ? `Suscriptor Tier ${session.user.tier}` : "Sin suscripción activa"}
          </p>
          <p class="text-xs text-white/40 mt-0.5 mb-4 leading-relaxed">
            {hasTier
              ? "Gracias por apoyar al canal. Tus perks están activos."
              : "Suscribite para desbloquear perks, emotes y sorteos."}
          </p>
          {!hasTier && (
            <a
              href="https://twitch.tv/subs/SaltoUruguayServer"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl bg-gradient-to-r from-[#9146FF] to-[#6d28d9] hover:brightness-110 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-violet-950/50 border border-violet-300/20"
            >
              Suscribirse <LucideExternalLink size={13} />
            </a>
          )}
          {hasTier && (
            <div class="w-full py-2.5 rounded-xl bg-amber-300/10 border border-amber-300/25 text-amber-200 text-center font-bold text-xs uppercase tracking-wider">
              Beneficios activos ✓
            </div>
          )}
        </section>

        {/* Accesos rápidos */}
        <nav class="rounded-3xl border border-white/10 bg-zinc-950/70 backdrop-blur-xl p-2.5 shadow-xl">
          <p class="text-[10px] font-bold uppercase tracking-widest text-white/35 px-3 pt-2 pb-1 flex items-center gap-1.5">
            <LucideSettings2 size={12} /> Accesos rápidos
          </p>
          {[
            { href: "/comunidad/member-card", icon: LucideIdCard, label: "Mi Member Card", desc: "Tu tarjeta de la comunidad", accent: "text-yellow-300" },
            { href: "/comunidad/juegos", icon: LucideSparkles, label: "Juegos", desc: "Ruleta, bingo y más", accent: "text-fuchsia-300" },
          ].map((l) => (
            <a
              href={l.href}
              class="group flex items-center gap-3 rounded-2xl px-3 py-2.5 hover:bg-white/5 transition-colors"
            >
              <span class="size-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0 group-hover:border-white/20 transition-colors">
                <l.icon size={16} class={l.accent} />
              </span>
              <span class="flex-1 min-w-0">
                <span class="block text-sm font-bold text-white leading-tight">{l.label}</span>
                <span class="block text-xs text-white/40 truncate">{l.desc}</span>
              </span>
              <LucideChevronRight size={15} class="text-white/25 group-hover:text-white/70 group-hover:translate-x-0.5 transition-all" />
            </a>
          ))}
        </nav>

        <p class="text-[11px] text-white/30 text-center leading-relaxed px-4">
          ¿Problemas con tu cuenta? Escribinos en el <a href="/comunidad/discord" class="text-indigo-300 hover:underline font-bold">Discord</a> de la comunidad.
        </p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { signOut } from "auth-astro/client";
  const btn = document.getElementById("account-logout");
  if (btn) {
    btn.addEventListener("click", () => signOut({ callbackUrl: "/" }));
  }
</script>
