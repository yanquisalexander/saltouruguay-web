---
import Layout from "@/layouts/Layout.astro";
import PageBackdrop from "@/components/PageBackdrop.astro";
import PageBreadcrumb from "@/components/PageBreadcrumb.astro";
import CommunityCard, { type CommunityItem } from "@/components/CommunityCard.astro";
import cacheService from "@/services/cache";

import { getTotalOfMemberCards } from "@/utils/user";
import { getSession } from "auth-astro/server";
import {
  LucideGamepad2,
  LucideTrophy,
  LucideWallet,
  LucideIdCard,
  LucideSparkles,
  LucideHeart,
  LucideImage,
  LucideSwords,
  LucideExternalLink,
  LucideCompass,
  LucideMedal,
} from "lucide-preact";

const session = await getSession(Astro.request);
const loggedIn = !!session;

// --- DATA DEFINITION ---

const APPS: CommunityItem[] = [
  {
    id: "saltocraft-extremo",
    path: "/comunidad/extremo4",
    requiresLogin: false,
    title: "SaltoCraft EXTREMO 4",
    description: "Llega la cuarta edición del desafío en Minecraft más grande de Latinoamérica.",
    image: "/images/SaltoCraft 4.webp",
    icon: LucideTrophy,
    soon: false,
    featured: true,
  },
  {
    id: "Guerra de Streamers 2",
    path: "/comunidad/guerra",
    requiresLogin: true,
    title: "Guerra de Streamers 2",
    description: "Se viene la segunda edición del evento más grande de la comunidad.",
    image: "/images/guerra.webp",
    icon: LucideSwords,
    soon: false,
  },
  {
    id: "liga-fortnite",
    path: "/liga-fortnite",
    requiresLogin: false,
    title: "Liga Fortnite",
    description: "Inscribite y competí en la Liga Fortnite oficial de ACRECONRE. Tres divisionales: Clasificatoria, Semi Profesional y Profesional.",
    image: "/images/liga.webp",
    icon: LucideTrophy,
    soon: false,
  },
  {
    id: "Torneo Rocket League",
    path: "/torneos/2",
    requiresLogin: true,
    title: "Torneo Rocket League",
    description: "Se jugó un Torneo Extraordinario con 16 Equipos.",
    image: "/images/rocket.webp",
    icon: LucideIdCard,
    soon: false,
  },
  {
    id: "server-hytale",
    path: "",
    url: "https://discord.gg/trrFvPHDKd",
    requiresLogin: true,
    title: "Nuevo server HYTALE",
    description: "Un nuevo juego se sumó a la comunidad Saltana.",
    image: "/images/hytale.webp",
    icon: LucideExternalLink,
    soon: false,
  },
  {
    id: "member-card",
    path: "/comunidad/member-card",
    requiresLogin: true,
    title: "Mi Member Card",
    description: "Tu identidad en la comunidad. Personaliza tu perfil.",
    image: "/images/member-card.webp",
    icon: LucideIdCard,
    soon: false,
  },
  {
    id: "mascota",
    path: "/comunidad/mascota",
    requiresLogin: true,
    title: "Mascota Saltana",
    description: "Adopta y cuida a tu compañero virtual.",
    image: "/images/pet-bg.webp",
    icon: LucideHeart,
    soon: false,
  },
  {
    id: "banco",
    path: "/comunidad/banco",
    requiresLogin: true,
    title: "Banco Saltano",
    description: "Gestiona tus SaltoCoins.",
    image: "/images/banco.webp",
    icon: LucideWallet,
    soon: true,
    soonCustomText: "Próximamente",
  },
  {
    id: "saltogram",
    path: "/saltogram",
    requiresLogin: true,
    title: "Saltogram",
    description: "Red social de la comunidad. Comparte y conecta.",
    image: "/images/saltogram.webp",
    icon: LucideImage,
    soon: false,
  },
];

const PROGRESSION: CommunityItem[] = [
  {
    id: "logros",
    path: "/comunidad/logros",
    requiresLogin: true,
    title: "Salón de Logros",
    description: "Tus hitos y medallas desbloqueadas.",
    image: "/images/achievements.webp",
    icon: LucideTrophy,
    soon: false,
  },
];

const GAMES: CommunityItem[] = [
  {
    id: "minigames",
    path: "/comunidad/juegos",
    requiresLogin: false,
    title: "Sala de Arcade",
    description: "Minijuegos para pasar el rato.",
    image: "/images/arcade-bg.webp",
    icon: LucideGamepad2,
    soon: true,
    soonCustomText: "En desarrollo",
  },
  {
    id: "ruleta-loca",
    path: "/comunidad/juegos/ruleta-loca",
    requiresLogin: false,
    title: "Ruleta Loca",
    description: "Un juego de ruleta emocionante.",
    image: "/images/ruleta-loca.webp",
    icon: LucideGamepad2,
    soon: false,
  },
];

// --- CACHE ---

const cache = cacheService.create({ ttl: 7200 });
let totalOfMemberCards: number | null = await cache.get("total-of-member-cards");

if (!totalOfMemberCards) {
  totalOfMemberCards = await getTotalOfMemberCards();
  if (import.meta.env.PROD) {
    await cache.set("total-of-member-cards", totalOfMemberCards);
  }
}
---

<Layout title="Comunidad">
  <PageBackdrop tone="amber" />

  <div class="flex flex-col max-w-6xl mx-auto min-h-screen mt-14 sm:mt-20 px-4 mb-20">
    <PageBreadcrumb
      pathname="/comunidad"
      breadcrumbs={[{ text: "Comunidad", href: "/comunidad" }]}
    />

    {/* HEADER */}
    <header class="relative flex flex-col items-center justify-center mb-10 mt-2 text-center">
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-4">
        <img
          src="/images/logo_salto.webp"
          alt="Salto Logo"
          class="size-14 sm:size-16 object-contain drop-shadow-[0_0_25px_rgba(251,191,36,0.3)]"
        />
        <div class="text-left">
          <p class="inline-flex items-center gap-1.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.2em] text-amber-200/80 bg-amber-400/10 border border-amber-300/25 rounded-full px-3 py-1 mb-2">
            <LucideCompass size={12} /> Hub comunitario
          </p>
          <h1 class="font-anton text-4xl sm:text-5xl text-white uppercase leading-[0.9]">
            Tu centro{" "}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-500">
              de mando
            </span>
          </h1>
        </div>
      </div>

      <p class="text-sm sm:text-base text-white/50 font-rubik max-w-xl mx-auto leading-relaxed">
        Gestiona tu perfil, revisa tus finanzas y diviértete con la comunidad.
      </p>

      {
        totalOfMemberCards !== null && totalOfMemberCards > 0 && (
          <div class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-500/10 border border-violet-400/25 text-violet-100 text-[13px] font-medium">
            <LucideSparkles size={15} class="text-amber-300 shrink-0" />
            <span>
              <span class="text-amber-300 font-bold tabular-nums">{totalOfMemberCards}</span>{" "}
              member card{totalOfMemberCards === 1 ? "" : "s"} creada{totalOfMemberCards === 1 ? "" : "s"}
            </span>
          </div>
        )
      }
    </header>

    {/* EXPLORAR */}
    <section aria-label="Explorar la comunidad">
      <div class="flex items-center gap-2.5 mb-4 px-1">
        <span class="size-8 rounded-lg bg-amber-400/10 border border-amber-300/25 flex items-center justify-center shrink-0">
          <LucideCompass size={16} class="text-amber-300" />
        </span>
        <h2 class="font-anton text-xl sm:text-2xl text-white uppercase tracking-wide">Explorar</h2>
        <span class="text-[11px] font-mono text-white/30 tabular-nums">{APPS.length}</span>
        <div class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent ml-1"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {APPS.map((item, i) => (
          <CommunityCard item={item} loggedIn={loggedIn} accent="amber" eager={i < 2} />
        ))}
      </div>
    </section>

    {/* PROGRESIÓN */}
    <section aria-label="Tu progresión" class="mt-10">
      <div class="flex items-center gap-2.5 mb-4 px-1">
        <span class="size-8 rounded-lg bg-violet-400/10 border border-violet-300/25 flex items-center justify-center shrink-0">
          <LucideMedal size={16} class="text-violet-300" />
        </span>
        <h2 class="font-anton text-xl sm:text-2xl text-white uppercase tracking-wide">Tu progresión</h2>
        <div class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent ml-1"></div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {PROGRESSION.map((item) => (
          <CommunityCard item={item} loggedIn={loggedIn} accent="violet" layout="row" />
        ))}
      </div>
    </section>

    {/* JUEGOS */}
    <section aria-label="Zona de juegos" class="mt-10">
      <div class="flex items-center gap-2.5 mb-4 px-1">
        <span class="size-8 rounded-lg bg-emerald-400/10 border border-emerald-300/25 flex items-center justify-center shrink-0">
          <LucideGamepad2 size={16} class="text-emerald-300" />
        </span>
        <h2 class="font-anton text-xl sm:text-2xl text-white uppercase tracking-wide">Zona de juegos</h2>
        <div class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent ml-1"></div>
      </div>

      {GAMES.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {GAMES.map((item) => (
            <CommunityCard item={item} loggedIn={loggedIn} accent="emerald" />
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-white/15 rounded-3xl p-10 flex flex-col items-center justify-center text-center">
          <LucideGamepad2 size={36} class="mb-3 text-white/25" />
          <p class="text-sm text-white/40 font-rubik">Próximamente nuevos juegos</p>
        </div>
      )}
    </section>
  </div>
</Layout>

<script>
  import { showSignInDialog } from "@/lib/utils";

  const handlePageLoad = async () => {
    const cards = document.querySelectorAll("[data-click-to-login]");
    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        event.preventDefault();
        showSignInDialog();
      });
    });
  };

  document.addEventListener("astro:page-load", handlePageLoad);

  document.addEventListener("astro:before-swap", () => {
    document.removeEventListener("astro:page-load", handlePageLoad);
  });
</script>
