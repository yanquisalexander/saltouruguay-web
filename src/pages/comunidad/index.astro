---
import Layout from "@/layouts/Layout.astro";
import PageBackdrop from "@/components/PageBackdrop.astro";
import PageBreadcrumb from "@/components/PageBreadcrumb.astro";
import type { CommunityItem } from "@/components/CommunityCard.astro";
import CommunityPortalCard from "@/components/CommunityPortalCard.astro";
import cacheService from "@/services/cache";

import { getTotalOfMemberCards } from "@/utils/user";
import { getSession } from "auth-astro/server";
import {
  LucideGamepad2,
  LucideTrophy,
  LucideWallet,
  LucideIdCard,
  LucideHeart,
  LucideImage,
  LucideSwords,
  LucideExternalLink,
} from "lucide-preact";

const session = await getSession(Astro.request);
const loggedIn = !!session;

// --- DATA DEFINITION ---

const APPS: CommunityItem[] = [
  {
    id: "saltocraft-extremo",
    path: "/comunidad/extremo4",
    requiresLogin: false,
    title: "SaltoCraft EXTREMO 4",
    description: "El mundo, los desafíos y las historias de la cuarta edición.",
    image: "/images/SaltoCraft 4.webp",
    icon: LucideTrophy,
    soon: false,
    featured: true,
  },
  {
    id: "Guerra de Streamers 2",
    path: "/comunidad/guerra",
    requiresLogin: true,
    title: "Guerra de Streamers 2",
    description: "Equipos, rivalidades y una comunidad que juega de ambos lados.",
    image: "/images/guerra.webp",
    icon: LucideSwords,
    soon: false,
  },
  {
    id: "liga-fortnite",
    path: "/liga-fortnite",
    requiresLogin: false,
    title: "Liga Fortnite",
    description: "Conocé la liga oficial de ACRECONRE y sus tres divisionales.",
    image: "/images/liga.webp",
    icon: LucideTrophy,
    soon: false,
  },
  {
    id: "Torneo Rocket League",
    path: "/torneos/2",
    requiresLogin: true,
    title: "Torneo Rocket League",
    description: "Se jugó un Torneo Extraordinario con 16 Equipos.",
    image: "/images/rocket.webp",
    icon: LucideIdCard,
    soon: false,
  },
  {
    id: "server-hytale",
    path: "",
    url: "https://discord.gg/trrFvPHDKd",
    requiresLogin: true,
    title: "Nuevo server HYTALE",
    description: "Un nuevo juego se sumó a la comunidad Saltana.",
    image: "/images/hytale.webp",
    icon: LucideExternalLink,
    soon: false,
  },
  {
    id: "member-card",
    path: "/comunidad/member-card",
    requiresLogin: true,
    title: "Mi Member Card",
    description: "Dale tu estilo a la tarjeta que te representa.",
    image: "/images/member-card.webp",
    icon: LucideIdCard,
    soon: false,
  },
  {
    id: "mascota",
    path: "/comunidad/mascota",
    requiresLogin: true,
    title: "Mascota Saltana",
    description: "Adoptá, cuidá y acompañá a tu compañero virtual.",
    image: "/images/pet-bg.webp",
    icon: LucideHeart,
    soon: false,
  },
  {
    id: "banco",
    path: "/comunidad/banco",
    requiresLogin: true,
    title: "Banco Saltano",
    description: "Gestiona tus SaltoCoins.",
    image: "/images/banco.webp",
    icon: LucideWallet,
    soon: true,
    soonCustomText: "Próximamente",
  },
  {
    id: "saltogram",
    path: "/saltogram",
    requiresLogin: true,
    title: "Saltogram",
    description: "Compartí lo que pasa y encontrate con los saltanos.",
    image: "/images/saltogram.webp",
    icon: LucideImage,
    soon: false,
  },
];

const PROGRESSION: CommunityItem[] = [
  {
    id: "logros",
    path: "/comunidad/logros",
    requiresLogin: true,
    title: "Salón de Logros",
    description: "Tus hitos y medallas desbloqueadas.",
    image: "/images/achievements.webp",
    icon: LucideTrophy,
    soon: false,
  },
];

const GAMES: CommunityItem[] = [
  {
    id: "minigames",
    path: "/comunidad/juegos",
    requiresLogin: false,
    title: "Arcade Saltano",
    description: "Entrá a la sala y elegí una partida multijugador.",
    image: "/images/arcade-bg.webp",
    icon: LucideGamepad2,
    soon: true,
    soonCustomText: "Próximamente",
  },
  {
    id: "ruleta-loca",
    path: "/comunidad/juegos/ruleta-loca",
    requiresLogin: false,
    title: "Ruleta Loca",
    description: "Girá la ruleta, descubrí la frase y desafiá a tus amigos.",
    image: "/images/ruleta-loca.webp",
    icon: LucideGamepad2,
    soon: false,
  },
  {
    id: "conga",
    path: "/comunidad/juegos/conga",
    requiresLogin: true,
    title: "Conga!",
    description: "La conga uruguaya en salas de hasta cuatro jugadores.",
    image: "/images/arcade-bg.webp",
    icon: LucideGamepad2,
    soon: true,
  },
];

// --- CACHE ---

const cache = cacheService.create({ ttl: 7200 });
let totalOfMemberCards: number | null = await cache.get("total-of-member-cards");

if (totalOfMemberCards == null) {
  totalOfMemberCards = await getTotalOfMemberCards();
  if (import.meta.env.PROD) {
    await cache.set("total-of-member-cards", totalOfMemberCards);
  }
}
const personal = [APPS.find(a => a.id === 'member-card')!, PROGRESSION[0], APPS.find(a => a.id === 'mascota')!, APPS.find(a => a.id === 'banco')!];
const events = APPS.slice(0, 4);
const social = APPS.filter(a => a.id === 'saltogram' || a.id === 'server-hytale');
---

<Layout title="Comunidad" description="Tu lugar en Salto: juegos, historias y gente para compartirlas.">
  <PageBackdrop tone="amber" />
  <div class="community-portal max-w-6xl mx-auto mt-14 sm:mt-20 px-4 pb-24">
    <PageBreadcrumb pathname="/comunidad" breadcrumbs={[{ text: 'Comunidad', href: '/comunidad' }]} />
    <header class="community-hero">
      <div class="hero-backdrop" aria-hidden="true"><img src="/images/SaltoCraft 4.webp" alt="" /><img src="/images/guerra.webp" alt="" /><img src="/images/arcade-bg.webp" alt="" /></div>
      <div class="hero-content">
        <img class="hero-logo" src="/images/logo_salto.webp" alt="SaltoUruguayServer" width="120" height="120" fetchpriority="high" />
        <h1>COMUNIDAD<br /><span>SALTANA</span></h1>
        <p>Jugá, compartí y dejá tu marca.</p>
        <div class="hero-actions"><a class="primary-action" href="#tu-espacio">EXPLORAR <LucideExternalLink size={18} /></a><a class="secondary-action" href="/como-participar">CÓMO PARTICIPAR</a></div>
        {totalOfMemberCards !== null && totalOfMemberCards > 0 && <div class="member-proof"><LucideIdCard size={15} /><span><strong>{totalOfMemberCards.toLocaleString('es-UY')}</strong> tarjetas de miembro creadas</span></div>}
      </div>
    </header>

    <nav class="portal-nav" aria-label="Secciones de comunidad"><a href="#tu-espacio"><LucideIdCard size={17} />Tu espacio</a><a href="#juegos"><LucideGamepad2 size={17} />Juegos</a><a href="#conectar"><LucideHeart size={17} />La gente</a><a href="#eventos"><LucideTrophy size={17} />Eventos</a></nav>

    <section id="tu-espacio" class="portal-section personal-section" aria-labelledby="personal-title">
      <div class="section-heading"><div><h2 id="personal-title">TU ESPACIO</h2><p>Tu identidad, tus compañeros y todo lo que vas consiguiendo.</p></div>{!loggedIn && <button type="button" class="session-button" data-community-login>INICIÁ SESIÓN <LucideExternalLink size={15} /></button>}</div>
      <div class="personal-grid">{personal.map(item => <CommunityPortalCard item={item} loggedIn={loggedIn} />)}</div>
    </section>

    <section id="juegos" class="portal-section games-section" aria-labelledby="games-title">
      <div class="section-heading"><div><h2 id="games-title">ZONA DE JUEGOS</h2><p>Elegí el juego. El resto lo ponemos entre todos.</p></div><a href="/comunidad/juegos" class="section-link">ENTRAR AL ARCADE <LucideExternalLink size={15} /></a></div>
      <div class="games-grid">{GAMES.map(item => <CommunityPortalCard item={item} loggedIn={loggedIn} variant="game" />)}</div>
    </section>

    <section id="conectar" class="portal-section social-section" aria-labelledby="social-title">
      <div class="social-intro"><LucideHeart size={30} /><h2 id="social-title">LA COMUNIDAD<br />SIGUE ACÁ.</h2><p>Compartí en Saltogram o sumate al servidor de Hytale desde Discord.</p></div>
      <div class="social-links">{social.map(item => <CommunityPortalCard item={item} loggedIn={loggedIn} />)}</div>
    </section>

    <section id="eventos" class="portal-section events-section" aria-labelledby="events-title">
      <div class="section-heading"><div><h2 id="events-title">EVENTOS SALTANOS</h2><p>Los mundos, los equipos y las partidas que reúnen a la comunidad.</p></div><span class="event-note">Explorá cada edición</span></div>
      <div class="events-grid">{events.map(item => <CommunityPortalCard item={item} loggedIn={loggedIn} variant="event" />)}</div>
    </section>
    <footer class="community-footer"><img src="/images/logo_salto.webp" alt="" width="40" height="40" loading="lazy" /><p>Hecho por y para la comunidad saltana.</p><a href="/como-participar">Cómo participar</a></footer>
  </div>
</Layout>

<style>
  .community-portal { font-family:var(--font-rubik); color:white; }
  .community-hero { position:relative; isolation:isolate; overflow:hidden; border:1px solid #ffffff20; border-radius:24px; margin:24px 0; background:#0d0916; }
  .hero-backdrop { position:absolute; inset:0; display:grid; grid-template-columns:repeat(3,1fr); z-index:-2; transform:skew(-12deg) scale(1.2); gap:8px; opacity:.48; }
  .hero-backdrop img { width:100%; height:100%; object-fit:cover; }
  .community-hero::after { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(0deg,#0b0716 0%,#0b071699 50%,#0b071655),radial-gradient(ellipse at 50% 30%,#7c3aed40,transparent 70%); }
  .hero-content { text-align:center; padding:36px 20px 30px; }
  .hero-logo { margin:0 auto 16px; width:100px; height:100px; object-fit:contain; filter:drop-shadow(0 0 25px #f59e0b55); }
  h1,h2 { font-family:var(--font-anton); font-weight:400; }
  h1 { font-size:clamp(3rem,8vw,6.5rem); line-height:.95; letter-spacing:-.02em; text-shadow:0 5px 0 #0008; }
  h1 span { display:inline-block; color:#fbbf24; text-shadow:0 4px 0 #78350f,0 0 45px #f59e0b35; }
  .hero-content > p { margin-top:22px; font-family:var(--font-teko); font-size:28px; color:#e9e0f5; letter-spacing:.02em; }
  .hero-actions { display:flex; justify-content:center; align-items:center; gap:14px; flex-wrap:wrap; margin-top:22px; }
  .primary-action,.secondary-action { display:flex; align-items:center; justify-content:center; gap:12px; padding:12px 24px; border-radius:10px; font-family:var(--font-anton); font-size:17px; letter-spacing:.04em; }
  .primary-action { background:#fbbf24; color:#211105; border:1px solid #fef3c7; box-shadow:0 4px 0 #92400e; }
  .primary-action:hover { background:#fcd34d; }
  .secondary-action { background:#7c3aed30; border:1px solid #c4b5fd70; color:#ede9fe; box-shadow:0 4px 0 #2e1065; }
  .secondary-action:hover { background:#7c3aed60; }
  .member-proof { display:flex; gap:8px; justify-content:center; align-items:center; color:#b9aecb; font-size:11px; margin-top:28px; }
  .member-proof strong { color:#fcd34d; }
  .portal-nav { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; padding:8px; border:1px solid #ffffff15; border-radius:14px; background:#09080ed9; }
  .portal-nav a { display:flex; align-items:center; justify-content:center; gap:10px; padding:12px 8px; font-family:var(--font-anton); text-transform:uppercase; font-size:17px; color:#c4b5fd; border-radius:8px; }
  .portal-nav a:hover { color:#fde68a; background:#fbbf2412; }
  .portal-section { margin-top:44px; scroll-margin-top:110px; }
  .section-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:22px; padding-left:16px; border-left:4px solid var(--section-accent,#fbbf24); }
  h2 { font-size:clamp(26px,3vw,36px); line-height:1.15; }
  .section-heading p { color:#ffffff80; font-size:13px; line-height:1.7; margin-top:8px; }
  .session-button,.section-link { display:flex; align-items:center; gap:8px; color:var(--section-accent,#fbbf24); font-family:var(--font-anton); font-size:15px; cursor:pointer; flex-shrink:0; }
  .personal-section { --section-accent:#fbbf24; }
  .personal-grid,.events-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18px; }
  .games-section { --section-accent:#67e8f9; padding:28px; background:#100e20; border:2px solid #a855f74d; border-radius:4px; box-shadow:6px 6px 0 #3b0764; }
  .games-section h2 { font-family:var(--font-press-start-2p); font-size:clamp(16px,2vw,24px); line-height:1.7; color:#67e8f9; }
  .games-section .section-heading { border-left-color:#e879f9; }
  .games-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
  .social-section { display:grid; grid-template-columns:.8fr 1.6fr; gap:32px; align-items:center; padding:30px; background:radial-gradient(ellipse at 0% 50%,#7c3aed33,transparent 70%),#09080ede; border:1px solid #a78bfa40; border-radius:20px; --section-accent:#c084fc; }
  .social-intro > svg { color:#c084fc; margin-bottom:18px; }
  .social-intro h2 { font-size:36px; }
  .social-intro p { color:#ffffff80; font-size:13px; line-height:1.8; margin-top:16px; max-width:30ch; }
  .social-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .events-section { --section-accent:#fb923c; }
  .event-note { color:#ffffff60; font-size:11px; }
  .community-footer { display:flex; align-items:center; gap:12px; margin-top:48px; border-top:1px solid #ffffff18; padding-top:24px; color:#ffffff60; font-size:12px; }
  .community-footer a { margin-left:auto; color:#c4b5fd; }
  a:focus-visible,button:focus-visible { outline:2px solid #fbbf24; outline-offset:5px; border-radius:4px; }
  @media(max-width:900px) { .personal-grid,.events-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .social-section { grid-template-columns:1fr; } .social-intro h2 br { display:none; } .social-intro p { max-width:none; } .games-grid { grid-template-columns:1fr; } }
  @media(max-width:540px) { .hero-content { padding:28px 16px; } .hero-logo { width:80px; height:80px; } .hero-content > p { font-size:24px; } .primary-action,.secondary-action { font-size:14px; padding:10px 16px; } .portal-nav { gap:2px; padding:4px; } .portal-nav a { flex-direction:column; gap:6px; font-size:12px; } .portal-section { margin-top:32px; } .section-heading { align-items:start; flex-direction:column; gap:12px; } .section-heading p { font-size:12px; } .personal-grid,.events-grid { gap:12px; } .games-section { padding:18px; } .social-section { padding:20px; gap:24px; } .social-links { grid-template-columns:1fr; } .social-intro h2 { font-size:30px; } .event-note { display:none; } .community-footer { flex-wrap:wrap; } .community-footer a { margin-left:52px; } }
  @media(prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important; transition:none !important; } }
</style>

<script>
  import { showSignInDialog } from '@/lib/utils';
  function setupCommunityPortal() {
    document.querySelectorAll<HTMLButtonElement>('[data-community-login]').forEach(button => {
      if (button.dataset.loginBound) return;
      button.dataset.loginBound = 'true';
      button.addEventListener('click', showSignInDialog);
    });
  }
  setupCommunityPortal();
  document.addEventListener('astro:page-load', setupCommunityPortal);
</script>
