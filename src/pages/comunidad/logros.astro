---
import { ACHIEVEMENTS, ACHIEVEMENTS_TEXTS, getAchievementCardUrl, getAchievementIconUrl } from "@/consts/Achievements";
import CommunityLayout from "@/layouts/CommunityLayout.astro";
import Layout from "@/layouts/Layout.astro";
import { getUserAchievements } from "@/utils/user";
import { getSession } from "auth-astro/server";
import {
  LucideLock,
  LucideTrophy,
  LucideCalendar,
  LucideSparkles,
  LucideMedal,
} from "lucide-preact";

const session = await getSession(Astro.request);

if (!session) {
  return new Response(null, {
    status: 404,
  });
}

const userAchievements = await getUserAchievements(session.user.id);
const totalAchievements = Object.keys(ACHIEVEMENTS).length;
const unlockedCount = userAchievements.length;
const progressPercentage = Math.round(
  (unlockedCount / totalAchievements) * 100
);

// Helper para formatear fecha
const formatDate = (dateString: Date) => {
  return new Date(dateString).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};
---

<Layout
  title="Mis Logros"
  description="Descubre los logros que has desbloqueado."
  noindex
>
  <div class="flex flex-col max-w-6xl mx-auto min-h-screen mt-8 px-4 pb-20">
    {/* --- HEADER --- */}
    <header
      class="relative overflow-hidden rounded-2xl border border-white/10 bg-linear-to-br from-gray-900 via-gray-900 to-black p-8 shadow-2xl mb-8"
    >
      <div
        class="absolute inset-0 bg-[url('/images/pattern-grid.svg')] opacity-5 pointer-events-none"
      >
      </div>
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-yellow-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
      >
      </div>

      <div
        class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6"
      >
        <div class="flex items-center gap-6">
          <div class="relative">
            <div class="absolute inset-0 bg-yellow-500 blur-xl opacity-20">
            </div>
            <LucideTrophy
              size={64}
              className="relative text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.5)]"
            />
          </div>
          <div>
            <h1
              class="font-teko text-4xl md:text-5xl font-bold text-white uppercase tracking-wide leading-none"
            >
              Salón de <span
                class="text-transparent bg-clip-text bg-linear-to-r from-yellow-400 to-orange-500"
                >Logros</span
              >
            </h1>
            <p class="font-rubik text-white/50 text-sm mt-1 max-w-md">
              Tu legado en la comunidad. Desbloquea hitos únicos participando en
              distintas actividades de la comunidad y la web.
            </p>
          </div>
        </div>

        {/* Progress Circle / Stat */}
        <div
          class="flex items-center gap-4 bg-white/5 p-4 rounded-xl border border-white/10 backdrop-blur-xs"
        >
          <div class="text-right">
            <span
              class="block text-xs font-rubik text-white/40 uppercase tracking-widest"
              >Progreso Total</span
            >
            <span class="block font-teko text-3xl font-bold text-white">
              <span class="text-yellow-400">{unlockedCount}</span> / {
                totalAchievements
              }
            </span>
          </div>
          <div
            class="relative size-16 flex items-center justify-center rounded-full border-4 border-white/10"
          >
            <svg
              class="size-full -rotate-90 absolute inset-0"
              viewBox="0 0 36 36"
            >
              <path
                class="text-yellow-500 transition-all duration-1000 ease-out"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-dasharray={`${progressPercentage}, 100`}></path>
            </svg>
            <span class="text-xs font-bold text-white"
              >{progressPercentage}%</span
            >
          </div>
        </div>
      </div>
    </header>

    {/* --- PROGRESS BAR COMPACT --- */}
    <div class="mb-10 relative group">
      <div
        class="absolute -inset-1 bg-linear-to-r from-yellow-500 to-orange-600 rounded-lg blur-sm opacity-10 group-hover:opacity-20 transition duration-1000 group-hover:duration-200"
      >
      </div>
      <div
        class="relative h-4 w-full bg-gray-900 rounded-full border border-white/10 overflow-hidden"
      >
        <div
          class="h-full bg-linear-to-r from-yellow-400 to-orange-500 shadow-[0_0_15px_rgba(234,179,8,0.5)] transition-all duration-1000 ease-out"
          style={{ width: `${progressPercentage}%` }}
        >
          <div
            class="w-full h-full bg-[url('/images/pattern-grid.svg')] opacity-20 bg-repeat-x animate-slide-bg"
          >
          </div>
        </div>
      </div>
      <div class="flex justify-between mt-2 px-1">
        <span class="text-xs font-rubik text-white/40">Novato</span>
        <span
          class="text-xs font-rubik text-yellow-500 font-bold tracking-widest uppercase"
          >Leyenda Saltana</span
        >
      </div>
    </div>

    {/* --- GRID DE CARTAS --- */}
    <ul class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-7">
      {
        Object.keys(ACHIEVEMENTS).map((key) => {
          // @ts-ignore
          const achievementId = ACHIEVEMENTS[key];
          const achievementText = ACHIEVEMENTS_TEXTS.find(
            (t) => t.id === achievementId
          );

          const userAchievement = userAchievements.find(
            (ua) => ua.achievementId === achievementId
          );
          const unlockedAt = userAchievement?.unlockedAt;
          const iconUrl = getAchievementIconUrl(achievementId);
          const cardUrl = getAchievementCardUrl(achievementId);
          const hasCardArt = !!achievementText?.card;

          // Estado visual
          const isUnlocked = !!unlockedAt;

          return (
            <li
              class="group relative cursor-pointer transition-all duration-300 hover:-translate-y-2"
              data-achievement-card
              data-achievement-id={achievementId}
              data-achievement-title={achievementText?.title}
              data-achievement-subtitle={achievementText?.subtitle ?? ""}
              data-achievement-description={achievementText?.description}
              data-achievement-icon={iconUrl}
              data-achievement-card-art={cardUrl}
              data-achievement-has-card={hasCardArt ? "true" : "false"}
              data-achievement-unlocked={isUnlocked ? "true" : "false"}
              data-achievement-date={unlockedAt ? formatDate(unlockedAt) : ""}
            >
              {/* Marco dorado / gris */}
              <div
                class={`
                  rounded-2xl p-[5px] transition-all duration-300
                  ${
                    isUnlocked
                      ? "bg-gradient-to-b from-yellow-200 via-amber-500 to-yellow-800 shadow-[0_0_25px_rgba(234,179,8,0.15)] group-hover:shadow-[0_0_45px_rgba(234,179,8,0.35)]"
                      : "bg-gradient-to-b from-zinc-700/70 to-zinc-900/70"
                  }
                `}
              >
                <div class="relative overflow-hidden rounded-xl bg-[#150c08] aspect-[2/3] flex flex-col">
                  {/* === ARTE en ventana (puede recortar; el modal la muestra completa) === */}
                  <div class="absolute inset-x-0 top-0 bottom-[31%] overflow-hidden">
                    {/* Fallback icono */}
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[radial-gradient(ellipse_at_center,#3b1d0e_0%,#150c08_70%)]">
                      <div class="absolute inset-0 bg-[url('/images/pattern-grid.svg')] opacity-10 pointer-events-none" />
                      <img
                        src={iconUrl}
                        alt=""
                        aria-hidden="true"
                        class={`relative size-24 object-contain drop-shadow-[0_0_15px_rgba(234,179,8,0.3)] ${isUnlocked ? "" : "grayscale opacity-60"}`}
                        style="image-rendering: pixelated;"
                      />
                    </div>
                    {/* Arte webp sobre el icono */}
                    {hasCardArt && (
                      <img
                        src={cardUrl}
                        alt={achievementText?.title}
                        loading="lazy"
                        onError="this.style.display='none'"
                        class={`absolute inset-0 h-full w-full object-cover object-top transition-all duration-300 group-hover:scale-105 ${isUnlocked ? "" : "grayscale"}`}
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-[#150c08] pointer-events-none" />
                    <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(0,0,0,0.6)] pointer-events-none" />
                  </div>

                  {/* === Overlay bloqueado === */}
                  {!isUnlocked && (
                    <div class="absolute inset-x-0 top-0 bottom-[31%] bg-black/55 flex items-center justify-center z-10">
                      <div class="bg-black/60 border border-white/15 p-3 rounded-full text-white/50 backdrop-blur-sm">
                        <LucideLock size={28} />
                      </div>
                    </div>
                  )}

                  {/* === Badge superior === */}
                  <div class="absolute top-2.5 left-2.5 right-2.5 flex items-start justify-between z-20">
                    <span
                      class={`
                        font-minecraftia text-[9px] uppercase tracking-widest px-2 py-1 rounded border backdrop-blur-sm
                        ${isUnlocked ? "bg-black/60 border-amber-400/50 text-amber-300" : "bg-black/60 border-white/10 text-white/40"}
                      `}
                    >
                      {isUnlocked ? "Desbloqueado" : "Bloqueado"}
                    </span>
                    {isUnlocked ? (
                      <div class="bg-amber-400/90 text-black p-1.5 rounded-lg shadow-[0_0_12px_rgba(251,191,36,0.6)]">
                        <LucideMedal size={16} />
                      </div>
                    ) : (
                      <div class="bg-black/60 border border-white/10 p-1.5 rounded-lg text-white/30">
                        <LucideLock size={16} />
                      </div>
                    )}
                  </div>

                  {/* === Remaches de esquina === */}
                  <span class="absolute top-1.5 left-1.5 size-2.5 border-t-2 border-l-2 border-amber-200/70 rounded-tl-sm z-20 pointer-events-none" />
                  <span class="absolute top-1.5 right-1.5 size-2.5 border-t-2 border-r-2 border-amber-200/70 rounded-tr-sm z-20 pointer-events-none" />
                  <span class="absolute bottom-1.5 left-1.5 size-2.5 border-b-2 border-l-2 border-amber-200/70 rounded-bl-sm z-20 pointer-events-none" />
                  <span class="absolute bottom-1.5 right-1.5 size-2.5 border-b-2 border-r-2 border-amber-200/70 rounded-br-sm z-20 pointer-events-none" />

                  {/* === PLACA INFERIOR (siempre: webp o svg) === */}
                  <div class="absolute inset-x-0 bottom-0 h-[31%] bg-[#0d0d0f] border-t-2 border-amber-500/60 flex flex-col items-center justify-center text-center px-3 py-2 z-10">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-300 to-transparent" />
                    <h2 class="font-minecraft text-amber-300 text-sm md:text-base leading-tight [text-shadow:0_2px_0_#000,0_3px_6px_rgba(0,0,0,0.8)] line-clamp-2">
                      {achievementText?.title.toUpperCase()}
                    </h2>
                    {achievementText?.subtitle && (
                      <p class="font-minecraftia text-[8px] md:text-[9px] text-white/55 uppercase tracking-widest mt-1.5 line-clamp-2 leading-relaxed">
                        {achievementText.subtitle}
                      </p>
                    )}
                    <div class="mt-1.5 flex items-center gap-1.5">
                      {isUnlocked ? (
                        <>
                          <LucideCalendar size={11} class="text-green-400" />
                          <span class="text-[10px] font-mono text-green-400/90">
                            {formatDate(unlockedAt)}
                          </span>
                        </>
                      ) : (
                        <span class="text-[10px] font-mono text-white/25 uppercase tracking-widest">
                          ???
                        </span>
                      )}
                    </div>
                  </div>

                  {/* === Brillo hover === */}
                  <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none z-30" />
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    {/* --- DIALOG MODAL: carta ampliada --- */}
    <dialog
      id="achievement-dialog"
      class="m-auto backdrop:bg-black/85 backdrop:backdrop-blur-xs bg-transparent p-0 max-w-2xl w-[calc(100vw-2rem)] rounded-2xl max-h-[92vh] overflow-y-auto"
    >
      <div class="rounded-2xl p-[5px] bg-gradient-to-b from-yellow-200 via-amber-500 to-yellow-800 shadow-2xl">
        <div class="relative overflow-hidden rounded-xl bg-[#150c08] flex flex-col md:flex-row">
          {/* Carta completa 2:3 sin recorte (altura fija: compacto en móvil) */}
          <div class="relative shrink-0 self-center md:self-auto w-auto h-[42vh] md:h-[68vh] md:min-h-[380px] aspect-[2/3] overflow-hidden bg-[radial-gradient(ellipse_at_center,#3b1d0e_0%,#150c08_70%)]">
            <div class="absolute inset-0 flex items-center justify-center">
              <img
                id="dialog-icon"
                src=""
                alt=""
                class="relative size-28 object-contain"
                style="image-rendering: pixelated;"
              />
            </div>
            <img
              id="dialog-card-art"
              src=""
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
              onError="this.style.display='none'"
            />
          </div>

          {/* Info lateral */}
          <div class="flex-1 min-w-[240px] bg-[#0d0d0f] border-t-2 md:border-t-0 md:border-l-2 border-amber-500/60 px-5 py-5 flex flex-col items-center md:items-start justify-center text-center md:text-left gap-2">
            <div id="dialog-status" class="flex items-center gap-2">
              {/* Se llena dinámicamente */}
            </div>
            <h2
              id="dialog-title"
              class="font-minecraft text-amber-300 text-lg leading-tight [text-shadow:0_2px_0_#000]"
            >
            </h2>
            <p
              id="dialog-subtitle"
              class="font-minecraftia text-[10px] text-white/55 uppercase tracking-widest"
            >
            </p>
            <p
              id="dialog-description"
              class="font-rubik text-white/70 text-sm leading-relaxed"
            >
            </p>
            <button
              id="dialog-close"
              class="mt-5 px-6 py-2 rounded-lg bg-white/10 hover:bg-white/20 border border-white/10 text-white font-rubik text-sm transition-colors"
            >
              Cerrar
            </button>
          </div>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<style>
  /* Opcional: animación suave para el fondo de la barra de progreso */
  @keyframes slide-bg {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 50px 0;
    }
  }
  .animate-slide-bg {
    animation: slide-bg 3s linear infinite;
  }

  /* Animación de entrada del dialog */
  dialog[open] {
    animation: dialog-show 0.3s ease-out forwards;
  }

  dialog::backdrop {
    animation: backdrop-show 0.3s ease-out forwards;
  }

  @keyframes dialog-show {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes backdrop-show {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { $, $$ } from "@/lib/dom-selector";

  const setupAchievementDialog = () => {
    const dialog = $("#achievement-dialog") as HTMLDialogElement;
    const cards = $$("[data-achievement-card]");
    const closeBtn = $("#dialog-close");

    // Elementos del dialog
    const dialogIcon = $("#dialog-icon") as HTMLImageElement;
    const dialogCardArt = $("#dialog-card-art") as HTMLImageElement;
    const dialogTitle = $("#dialog-title");
    const dialogSubtitle = $("#dialog-subtitle");
    const dialogDescription = $("#dialog-description");
    const dialogStatus = $("#dialog-status");

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const title = card.getAttribute("data-achievement-title") || "";
        const subtitle = card.getAttribute("data-achievement-subtitle") || "";
        const description =
          card.getAttribute("data-achievement-description") || "";
        const icon = card.getAttribute("data-achievement-icon") || "";
        const cardArt = card.getAttribute("data-achievement-card-art") || icon;
        const hasCard =
          card.getAttribute("data-achievement-has-card") === "true";
        const isUnlocked =
          card.getAttribute("data-achievement-unlocked") === "true";
        const date = card.getAttribute("data-achievement-date") || "";

        // Actualizar contenido
        if (dialogIcon) {
          dialogIcon.src = icon;
          dialogIcon.alt = title;
          dialogIcon.className = isUnlocked
            ? "relative size-28 object-contain"
            : "relative size-28 object-contain grayscale opacity-60";
        }
        if (dialogCardArt) {
          if (hasCard) {
            dialogCardArt.style.display = "";
            dialogCardArt.src = cardArt;
            dialogCardArt.alt = title;
            dialogCardArt.className = isUnlocked
              ? "absolute inset-0 h-full w-full object-cover"
              : "absolute inset-0 h-full w-full object-cover grayscale";
          } else {
            dialogCardArt.style.display = "none";
            dialogCardArt.removeAttribute("src");
          }
        }
        if (dialogTitle) dialogTitle.textContent = title.toUpperCase();
        if (dialogSubtitle) {
          dialogSubtitle.textContent = subtitle;
          (dialogSubtitle as HTMLElement).style.display = subtitle ? "" : "none";
        }
        if (dialogDescription) dialogDescription.textContent = description;

        // Actualizar status
        if (dialogStatus) {
          if (isUnlocked) {
            dialogStatus.innerHTML = `
              <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/60 border border-amber-400/50 text-amber-300 text-xs font-medium backdrop-blur-sm">
                ★ Desbloqueado el ${date}
              </span>
            `;
          } else {
            dialogStatus.innerHTML = `
              <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/60 border border-white/10 text-white/50 text-xs font-medium backdrop-blur-sm">
                Aún no desbloqueado
              </span>
            `;
          }
        }

        dialog.showModal();
      });
    });

    // Cerrar con botón
    closeBtn?.addEventListener("click", () => {
      dialog.close();
    });

    // Cerrar al hacer click fuera
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });

    // Cerrar con Escape (ya viene por defecto, pero por si acaso)
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        dialog.close();
      }
    });
  };

  // Ejecutar en carga y en navegación de Astro
  document.addEventListener("astro:page-load", setupAchievementDialog);
</script>
