---
import Layout from "../layouts/Layout.astro";
import Sponsors from "@/sections/Sponsors.astro";
import LiveStream from "@/components/LiveStream.astro";
import VoteCallToAction from "@/components/VoteCallToAction.astro";
import NewsOnPage from "@/sections/NewsOnPage.astro";
import { FeaturedNews } from "@/components/FeaturedNews";
import Advantages from "@/sections/Advantages.astro";
import Required2FA from "@/components/admin/Required2FA.astro";
import { LucideChevronsDown } from "lucide-preact";

import { CHRISTMAS_MODE, HALLOWEEN_MODE } from "@/config";

const IS_PROD = import.meta.env.PROD;
export const prerender = true;

// Detectar login=true + redirect para flujo OAuth seamless
const url = new URL(Astro.request.url);
const loginParam = url.searchParams.get("login");
const redirectParam = url.searchParams.get("redirect");

// Lógica de estilos condicionales
const subtitleGradient = HALLOWEEN_MODE
  ? "from-orange-400 via-amber-300 to-purple-400 bg-size-[200%_auto] animate-shine"
  : CHRISTMAS_MODE
  ? "from-red-500 via-green-500 to-red-500 bg-size-[200%_auto] animate-shine"
  : "from-blue-400 to-purple-500";

const titleShadow = HALLOWEEN_MODE
  ? "drop-shadow-[0_0_30px_rgba(249,115,22,0.5)]"
  : CHRISTMAS_MODE
  ? "drop-shadow-[0_0_15px_rgba(220,38,38,0.5)]"
  : "drop-shadow-lg";

const heroGlow = HALLOWEEN_MODE
  ? "bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.18)_0%,rgba(168,85,247,0.12)_45%,transparent_70%)]"
  : CHRISTMAS_MODE
  ? "bg-[radial-gradient(circle_at_center,rgba(220,38,38,0.15)_0%,transparent_60%)]"
  : "bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.04)_0%,transparent_60%)]";
---

<Layout
  title="Comunidad SaltoUruguayServer"
  description="Te damos la bienvenida a la comunidad del canal de SaltoUruguayServer en Twitch. ¡Viví los mejores eventos y streams!"
>
  <main class="relative w-full text-white">
    {/* ❄️ EFECTO DE NIEVE */}
    {
      CHRISTMAS_MODE && (
        <div
          class="fixed inset-0 z-50 pointer-events-none overflow-hidden"
          aria-hidden="true"
        >
          <div class="snow" />
          <div class="snow layer2" />
          <div class="snow layer3" />
        </div>
      )
    }

    {/* 🎃 EFECTOS AMBIENTALES DE HALLOWEEN (DETRÁS DEL CONTENIDO) */}
    {
      HALLOWEEN_MODE && (
        <>
          {/* Murciélagos volando en el fondo */}
          <div
            class="pointer-events-none fixed inset-0 z-20 overflow-hidden"
            aria-hidden="true"
          >
            <div class="bat bat-1">🦇</div>
            <div class="bat bat-2">🦇</div>
            <div class="bat bat-3">🦇</div>
            <div class="bat bat-4">🦇</div>
          </div>

          {/* Niebla espeluznante en el fondo (z-index negativo para no tapar nada) */}
          <div
            class="pointer-events-none absolute inset-0 -z-10 overflow-hidden opacity-40"
            aria-hidden="true"
          >
            <div class="spooky-fog-container">
              <div class="spooky-fog" />
              <div class="spooky-fog fog-2" />
            </div>
          </div>
        </>
      )
    }

    <section
      id="hero"
      class="relative -mt-24 flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden pt-20 pb-12"
    >
      {/* Telarañas en esquinas superiores si Halloween está activo */}
      {
        HALLOWEEN_MODE && (
          <div
            class="pointer-events-none absolute top-20 left-0 right-0 z-0 flex justify-between px-4 opacity-30 select-none"
            aria-hidden="true"
          >
            <svg class="w-28 h-28 text-orange-500/50" viewBox="0 0 100 100" fill="none">
              <path d="M0 0 L100 0 L0 100 Z M10 10 Q 50 20, 90 0 M10 10 Q 20 50, 0 90 M25 25 Q 55 35, 75 0 M25 25 Q 35 55, 0 75" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <svg class="w-28 h-28 text-purple-500/50 transform scale-x-[-1]" viewBox="0 0 100 100" fill="none">
              <path d="M0 0 L100 0 L0 100 Z M10 10 Q 50 20, 90 0 M10 10 Q 20 50, 0 90 M25 25 Q 55 35, 75 0 M25 25 Q 35 55, 0 75" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
        )
      }

      {/* Efecto de iluminación atmosférica de fondo (-z-10 para no tapar nada) */}
      <div
        class={`pointer-events-none absolute inset-0 -z-10 transition-all duration-1000 ${heroGlow}`}
      >
      </div>

      {/* Fondo de partículas animadas */}
      <div
        class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class={`particle particle-1 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-2 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-3 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-4 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-5 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-6 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-7 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-8 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-9 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-10 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-11 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-12 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-13 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-14 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-15 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
      </div>

      {/* Formas geométricas flotantes */}
      <div
        class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
      </div>

      <div
        class="relative z-10 mx-auto flex max-w-5xl flex-col items-center gap-8 px-6 text-center"
      >
        {/* Alertas - Con un toque de glassmorphism */}
        <div
          class="flex w-full max-w-md flex-col items-center gap-3 animate-fade-in-down backdrop-blur-xs"
        >
          <Required2FA server:defer />
        </div>

        {/* 🎃 Halloween Special Badge con texto interactivo y aleatorio */}
        {
          HALLOWEEN_MODE && (
            <div
              id="spooky-badge"
              class="animate-bounce-subtle flex items-center gap-2.5 px-5 py-2 rounded-full bg-linear-to-r from-orange-500/20 via-purple-500/30 to-orange-500/20 border border-orange-500/40 backdrop-blur-md shadow-[0_0_20px_rgba(249,115,22,0.35)] cursor-pointer select-none transition-all hover:scale-105"
              title="¡Haz clic para cambiar la frase!"
            >
              <span class="text-lg">🎃</span>
              <span
                id="spooky-text"
                class="text-xs md:text-sm font-bold uppercase tracking-widest text-transparent bg-clip-text bg-linear-to-r from-orange-400 via-amber-300 to-purple-300 transition-opacity duration-300"
              >
                Especial Noche de Brujas
              </span>
              <span class="text-lg">👻</span>
            </div>
          )
        }

        <header
          class="flex flex-col items-center justify-center gap-8 md:flex-row md:gap-14"
        >
          {/* Logo - Con un halo de luz sutil o toque Halloween al pasar el mouse */}
          <div
            class={`group relative animate-fade-in ${
              HALLOWEEN_MODE
                ? "halloween-logo"
                : CHRISTMAS_MODE
                ? "christmas-logo"
                : ""
            }`}
          >
            <div
              class={`absolute -inset-4 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100 ${
                HALLOWEEN_MODE ? "bg-orange-500/30" : "bg-white/10"
              }`}
            >
            </div>
            <img
              src="/favicon.svg"
              alt="SaltoUruguayServer Logo"
              draggable="false"
              fetchpriority="high"
              loading="eager"
              class={`relative h-28 w-auto object-contain transition-all duration-500 ease-out group-hover:scale-105 md:h-40 ${
                HALLOWEEN_MODE
                  ? "drop-shadow-[0_0_25px_rgba(249,115,22,0.4)] group-hover:drop-shadow-[0_0_35px_rgba(249,115,22,0.7)]"
                  : "drop-shadow-[0_0_15px_rgba(255,255,255,0.05)] group-hover:drop-shadow-[0_0_25px_rgba(255,255,255,0.15)]"
              }`}
            />
          </div>

          {/* Títulos */}
          <div class="animate-fade-in-up space-y-3 text-center md:text-left">
            {/* Título Principal */}
            <h1
              class={`font-anton text-5xl tracking-wide text-white transition-all duration-500 sm:text-6xl md:text-7xl ${titleShadow}`}
            >
              SALTO URUGUAY
            </h1>

            {/* Subtítulo con Gradiente Dinámico */}
            <h2
              class={`bg-linear-to-r ${subtitleGradient} bg-clip-text font-sans text-lg font-semibold tracking-[0.25em] text-transparent md:text-xl`}
            >
              SERVER COMMUNITY
            </h2>
          </div>
        </header>
      </div>

      {/* Scroll indicator - Estilo más técnico/gaming */}
      <a
        href="#stream-section"
        class="absolute bottom-6 text-white/30 transition-all hover:-translate-y-1 hover:text-white/80 animate-bounce cursor-pointer"
        aria-label="Ir al contenido"
      >
        <LucideChevronsDown size={28} stroke-width="2" />
      </a>
    </section>

    {/* CONTENIDO PRINCIPAL */}
    <div
      class="relative z-10 mx-auto flex max-w-7xl flex-col gap-24 px-4 pb-20"
    >
      <div id="stream-section" class="scroll-mt-32">
        <LiveStream server:defer />
      </div>
      <FeaturedNews client:only />
      <Advantages />
      <NewsOnPage />
      <Sponsors />
    </div>
  </main>
</Layout>

<style>
  /* Animaciones CSS Puras */
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }

  .animate-fade-in-down {
    animation: fadeInDown 1s ease-out forwards;
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 1s ease-out 0.3s forwards;
  }

  .animate-bounce-subtle {
    animation: bounceSubtle 3s ease-in-out infinite;
  }

  @keyframes bounceSubtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Animación para el gradiente festivo */
  .animate-shine {
    animation: backgroundShine 4s linear infinite;
  }

  @keyframes backgroundShine {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 🎃 ESTILOS DE HALLOWEEN */
  .halloween-logo::before {
    content: "🎃";
    position: absolute;
    top: -28px;
    left: -18px;
    font-size: 3.5rem;
    z-index: 20;
    transform: rotate(-12deg);
    animation: pumpkinWobble 3s infinite ease-in-out;
    filter: drop-shadow(0 0 12px rgba(249, 115, 22, 0.7));
  }

  @keyframes pumpkinWobble {
    0%, 100% {
      transform: rotate(-12deg) translateY(0) scale(1);
    }
    50% {
      transform: rotate(-5deg) translateY(-8px) scale(1.08);
    }
  }

  /* Murciélagos volando en el fondo */
  .bat {
    position: absolute;
    font-size: 1.8rem;
    opacity: 0;
    z-index: 10;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    animation: flyBat 14s linear infinite;
  }

  .bat-1 {
    top: 15%;
    left: -5%;
    animation-duration: 16s;
    animation-delay: 0s;
  }
  .bat-2 {
    top: 35%;
    left: -5%;
    animation-duration: 12s;
    animation-delay: 4s;
    font-size: 1.4rem;
  }
  .bat-3 {
    top: 25%;
    left: -5%;
    animation-duration: 18s;
    animation-delay: 8s;
    font-size: 2.2rem;
  }
  .bat-4 {
    top: 45%;
    left: -5%;
    animation-duration: 15s;
    animation-delay: 2s;
    font-size: 1.6rem;
  }

  @keyframes flyBat {
    0% {
      transform: translateX(0vw) translateY(0px) rotate(5deg);
      opacity: 0;
    }
    10% {
      opacity: 0.7;
    }
    30% {
      transform: translateX(30vw) translateY(-40px) rotate(-10deg);
    }
    50% {
      transform: translateX(55vw) translateY(20px) rotate(8deg);
    }
    80% {
      transform: translateX(85vw) translateY(-30px) rotate(-5deg);
      opacity: 0.7;
    }
    100% {
      transform: translateX(105vw) translateY(10px) rotate(5deg);
      opacity: 0;
    }
  }

  /* Contenedor de Niebla (Posicionada detrás con -z-10) */
  .spooky-fog-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 220px;
    pointer-events: none;
    overflow: hidden;
  }

  .spooky-fog {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(249, 115, 22, 0.12) 0%,
      rgba(168, 85, 247, 0.08) 40%,
      transparent 75%
    );
    animation: creepFog 25s linear infinite;
  }

  .spooky-fog.fog-2 {
    animation: creepFog 18s linear infinite reverse;
    opacity: 0.7;
    background: radial-gradient(
      ellipse at center,
      rgba(168, 85, 247, 0.15) 0%,
      rgba(249, 115, 22, 0.08) 50%,
      transparent 80%
    );
  }

  @keyframes creepFog {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .particle.halloween-particle {
    background: radial-gradient(
      circle,
      rgba(249, 115, 22, 0.8) 0%,
      rgba(168, 85, 247, 0) 70%
    );
  }

  /* 🎅 ESTILOS DE NAVIDAD */
  .christmas-logo::before {
    content: "🎅";
    position: absolute;
    top: -30px;
    left: -20px;
    font-size: 4rem;
    z-index: 20;
    transform: rotate(-15deg);
    animation: bounceHat 2s infinite ease-in-out;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.3));
  }

  @keyframes bounceHat {
    0%, 100% {
      transform: rotate(-15deg) translateY(0);
    }
    50% {
      transform: rotate(-10deg) translateY(-5px);
    }
  }

  /* Efecto de Nieve (CSS Only - Performance Friendly) */
  .snow {
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(4px 4px at 100px 50px, #fff, transparent),
      radial-gradient(6px 6px at 200px 150px, #fff, transparent),
      radial-gradient(3px 3px at 300px 250px, #fff 50%, transparent),
      radial-gradient(4px 4px at 400px 350px, #fff 50%, transparent),
      radial-gradient(6px 6px at 500px 100px, #fff 50%, transparent),
      radial-gradient(3px 3px at 50px 200px, #fff 50%, transparent),
      radial-gradient(4px 4px at 150px 300px, #fff 50%, transparent),
      radial-gradient(6px 6px at 250px 400px, #fff 50%, transparent),
      radial-gradient(6px 6px at 350px 500px, #fff 50%, transparent);
    background-size: 550px 550px;
    animation: snow 10s linear infinite;
    opacity: 0.6;
  }

  .snow.layer2 {
    background-image:
      radial-gradient(4px 4px at 50px 250px, #fff, transparent),
      radial-gradient(6px 6px at 150px 350px, #fff, transparent),
      radial-gradient(3px 3px at 250px 450px, #fff 50%, transparent),
      radial-gradient(4px 4px at 350px 50px, #fff 50%, transparent);
    background-size: 350px 350px;
    animation: snow 6s linear infinite reverse;
    opacity: 0.4;
    filter: blur(1px);
  }

  .snow.layer3 {
    background-image: radial-gradient(
      3px 3px at 100px 100px,
      #fff,
      transparent
    );
    background-size: 250px 250px;
    animation: snow 4s linear infinite;
    opacity: 0.3;
  }

  @keyframes snow {
    0% {
      transform: translateY(-550px);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* ✨ PARTÍCULAS ANIMADAS DEL HERO */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(145, 70, 255, 0.8) 0%,
      rgba(145, 70, 255, 0) 70%
    );
    animation: floatParticle linear infinite;
    opacity: 0;
  }

  .particle-1 { width: 4px; height: 4px; left: 10%; animation-duration: 20s; animation-delay: 0s; }
  .particle-2 { width: 6px; height: 6px; left: 20%; animation-duration: 25s; animation-delay: 2s; }
  .particle-3 { width: 3px; height: 3px; left: 35%; animation-duration: 18s; animation-delay: 4s; }
  .particle-4 { width: 5px; height: 5px; left: 50%; animation-duration: 22s; animation-delay: 1s; }
  .particle-5 { width: 4px; height: 4px; left: 65%; animation-duration: 28s; animation-delay: 3s; }
  .particle-6 { width: 7px; height: 7px; left: 75%; animation-duration: 19s; animation-delay: 5s; }
  .particle-7 { width: 3px; height: 3px; left: 85%; animation-duration: 24s; animation-delay: 2s; }
  .particle-8 { width: 5px; height: 5px; left: 90%; animation-duration: 21s; animation-delay: 6s; }
  .particle-9 { width: 4px; height: 4px; left: 5%; animation-duration: 26s; animation-delay: 7s; }
  .particle-10 { width: 6px; height: 6px; left: 45%; animation-duration: 23s; animation-delay: 8s; }
  .particle-11 { width: 3px; height: 3px; left: 55%; animation-duration: 27s; animation-delay: 1s; }
  .particle-12 { width: 5px; height: 5px; left: 30%; animation-duration: 20s; animation-delay: 4s; }
  .particle-13 { width: 4px; height: 4px; left: 70%; animation-duration: 22s; animation-delay: 9s; }
  .particle-14 { width: 6px; height: 6px; left: 15%; animation-duration: 25s; animation-delay: 3s; }
  .particle-15 { width: 3px; height: 3px; left: 60%; animation-duration: 19s; animation-delay: 6s; }

  @keyframes floatParticle {
    0% {
      transform: translateY(100vh) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0.6;
    }
    100% {
      transform: translateY(-100px) translateX(50px);
      opacity: 0;
    }
  }

  /* 🔷 FORMAS GEOMÉTRICAS FLOTANTES */
  .floating-shape {
    position: absolute;
    opacity: 0.03;
    animation: floatShape 15s ease-in-out infinite;
  }

  .shape-1 {
    width: 200px;
    height: 200px;
    top: 20%;
    left: 10%;
    border: 2px solid rgba(145, 70, 255, 0.5);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation-duration: 20s;
  }

  .shape-2 {
    width: 150px;
    height: 150px;
    top: 60%;
    right: 15%;
    border: 2px solid rgba(168, 85, 247, 0.5);
    transform: rotate(45deg);
    animation-duration: 18s;
    animation-delay: 3s;
  }

  .shape-3 {
    width: 100px;
    height: 100px;
    bottom: 25%;
    left: 20%;
    border: 2px solid rgba(192, 132, 252, 0.5);
    border-radius: 50%;
    animation-duration: 22s;
    animation-delay: 6s;
  }

  @keyframes floatShape {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-30px) rotate(90deg);
    }
    50% {
      transform: translateY(0) rotate(180deg);
    }
    75% {
      transform: translateY(30px) rotate(270deg);
    }
  }
</style>

<script is:inline>
  // Script 1: Cambio dinámico de frase en el Badge de Halloween
  (function () {
    const spookyMessages = [
      "¿Dulce o truco en Salto Uruguay? 🎃",
      "Cuidado con las brujas en el chat 🧹",
      "Noche de Terror en el Server 🦇",
      "No mires debajo de tu cama... 👁️",
      "Los espíritus están transmitiendo 🔮",
      "¿Caramelos para el streamer? 🍬",
      "La medianoche se acerca... 💀",
      "Zombis sueltos en Ruleta Loca 🧟",
      "Habitación 666 conectada 👻",
      "Sonidos extraños en Discord... 🕸️",
      "¡Feliz Noche de Brujas! 🎃"
    ];

    function initSpookyBadge() {
      const $badge = document.getElementById("spooky-badge");
      const $text = document.getElementById("spooky-text");
      if (!$text) return;

      let currentIdx = Math.floor(Math.random() * spookyMessages.length);
      $text.textContent = spookyMessages[currentIdx];

      const changeText = () => {
        $text.style.opacity = "0";
        setTimeout(() => {
          currentIdx = (currentIdx + 1 + Math.floor(Math.random() * (spookyMessages.length - 1))) % spookyMessages.length;
          $text.textContent = spookyMessages[currentIdx];
          $text.style.opacity = "1";
        }, 300);
      };

      if ($badge) {
        $badge.onclick = changeText;
      }

      if (window.__spookyInterval) clearInterval(window.__spookyInterval);
      window.__spookyInterval = setInterval(changeText, 5000);
    }

    document.addEventListener("astro:page-load", initSpookyBadge);
    initSpookyBadge();
  })();

  // Script 2: Flujo OAuth seamless: guardar redirect y redirigir post-login
  (function () {
    const params = new URLSearchParams(window.location.search);
    const login = params.get("login");
    const redirect = params.get("redirect");

    if (login === "true" && redirect) {
      sessionStorage.setItem("oauth_redirect", redirect);
    }

    if (!login && sessionStorage.getItem("oauth_redirect")) {
      fetch("/api/auth/session")
        .then((r) => r.json())
        .then((data) => {
          if (data && data.user) {
            const target = sessionStorage.getItem("oauth_redirect");
            sessionStorage.removeItem("oauth_redirect");
            if (target) {
              window.location.href = target;
            }
          }
        })
        .catch(() => {});
    }
  })();
</script>
