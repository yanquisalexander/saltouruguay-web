---
import Layout from "../layouts/Layout.astro";
import Sponsors from "@/sections/Sponsors.astro";
import LiveStream from "@/components/LiveStream.astro";
import NewsOnPage from "@/sections/NewsOnPage.astro";
import { FeaturedNews } from "@/components/FeaturedNews";
import Advantages from "@/sections/Advantages.astro";
import Required2FA from "@/components/admin/Required2FA.astro";
import { LucideChevronsDown, LucideUsers, LucideArrowRight, LucideGamepad2, LucideTrophy, LucideIdCard, LucideSparkles } from "lucide-preact";

import { CHRISTMAS_MODE, HALLOWEEN_MODE } from "@/config";

const IS_PROD = import.meta.env.PROD;
export const prerender = true;

// Detectar login=true + redirect para flujo OAuth seamless
const url = new URL(Astro.request.url);
const loginParam = url.searchParams.get("login");
const redirectParam = url.searchParams.get("redirect");

// Lógica de estilos condicionales
const subtitleGradient = HALLOWEEN_MODE
  ? "from-orange-400 via-amber-300 to-purple-400 bg-size-[200%_auto] animate-shine"
  : CHRISTMAS_MODE
  ? "from-red-500 via-green-500 to-red-500 bg-size-[200%_auto] animate-shine"
  : "from-purple-400 to-pink-500";

const titleShadow = HALLOWEEN_MODE
  ? "drop-shadow-[0_0_30px_rgba(249,115,22,0.5)]"
  : CHRISTMAS_MODE
  ? "drop-shadow-[0_0_15px_rgba(220,38,38,0.5)]"
  : "drop-shadow-lg";

const heroGlow = HALLOWEEN_MODE
  ? "bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.18)_0%,rgba(168,85,247,0.12)_45%,transparent_70%)]"
  : CHRISTMAS_MODE
  ? "bg-[radial-gradient(circle_at_center,rgba(220,38,38,0.15)_0%,transparent_60%)]"
  : "bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.04)_0%,transparent_60%)]";
---

<Layout
  title="Comunidad SaltoUruguayServer"
  description="Te damos la bienvenida a la comunidad del canal de SaltoUruguayServer en Twitch. ¡Viví los mejores eventos y streams!"
  mainClassname="p-0"
>
  <div class="home-page relative w-full text-white">
    {/* ❄️ EFECTO DE NIEVE */}
    {
      CHRISTMAS_MODE && (
        <div
          class="fixed inset-0 z-50 pointer-events-none overflow-hidden"
          aria-hidden="true"
        >
          <div class="snow" />
          <div class="snow layer2" />
          <div class="snow layer3" />
        </div>
      )
    }

    {/* 🎃 EFECTOS AMBIENTALES DE HALLOWEEN (DETRÁS DEL CONTENIDO) */}
    {
      HALLOWEEN_MODE && (
        <>
          {/* Murciélagos volando en el fondo */}
          <div
            class="pointer-events-none fixed inset-0 z-20 overflow-hidden"
            aria-hidden="true"
          >
            <div class="bat bat-1">🦇</div>
            <div class="bat bat-2">🦇</div>
            <div class="bat bat-3">🦇</div>
            <div class="bat bat-4">🦇</div>
          </div>

          {/* Niebla espeluznante en el fondo (z-index negativo para no tapar nada) */}
          <div
            class="pointer-events-none absolute inset-0 -z-10 overflow-hidden opacity-40"
            aria-hidden="true"
          >
            <div class="spooky-fog-container">
              <div class="spooky-fog" />
              <div class="spooky-fog fog-2" />
            </div>
          </div>
        </>
      )
    }

    <section
      id="hero"
      class="home-hero relative flex w-full flex-col items-center justify-center overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20"
    >
      {/* Telarañas en esquinas superiores si Halloween está activo */}
      {
        HALLOWEEN_MODE && (
          <div
            class="pointer-events-none absolute top-20 left-0 right-0 z-0 flex justify-between px-4 opacity-30 select-none"
            aria-hidden="true"
          >
            <svg class="w-28 h-28 text-orange-500/50" viewBox="0 0 100 100" fill="none">
              <path d="M0 0 L100 0 L0 100 Z M10 10 Q 50 20, 90 0 M10 10 Q 20 50, 0 90 M25 25 Q 55 35, 75 0 M25 25 Q 35 55, 0 75" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <svg class="w-28 h-28 text-purple-500/50 transform scale-x-[-1]" viewBox="0 0 100 100" fill="none">
              <path d="M0 0 L100 0 L0 100 Z M10 10 Q 50 20, 90 0 M10 10 Q 20 50, 0 90 M25 25 Q 55 35, 75 0 M25 25 Q 35 55, 0 75" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
        )
      }

      {/* Efecto de iluminación atmosférica de fondo (-z-10 para no tapar nada) */}
      <div
        class={`pointer-events-none absolute inset-0 -z-10 transition-all duration-1000 ${heroGlow}`}
      >
      </div>

      {/* Fondo de partículas animadas */}
      <div
        class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class={`particle particle-1 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-2 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-3 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-4 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-5 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-6 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-7 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-8 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-9 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-10 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-11 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-12 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-13 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-14 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
        <div class={`particle particle-15 ${HALLOWEEN_MODE ? "halloween-particle" : ""}`}></div>
      </div>

      {/* Formas geométricas flotantes */}
      <div
        class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
      </div>

      <div
        class="relative z-10 mx-auto flex max-w-5xl flex-col items-center gap-8 px-6 text-center"
      >
        {/* Alertas - Con un toque de glassmorphism */}
        <div
          class="flex w-full max-w-md flex-col items-center gap-3 animate-fade-in-down backdrop-blur-xs"
        >
          <Required2FA server:defer />
        </div>

        {/* 🎃 Halloween Special Badge con texto interactivo y aleatorio */}
        {
          HALLOWEEN_MODE && (
            <div
              id="spooky-badge"
              class="animate-bounce-subtle flex items-center gap-2.5 px-5 py-2 rounded-full bg-linear-to-r from-orange-500/20 via-purple-500/30 to-orange-500/20 border border-orange-500/40 backdrop-blur-md shadow-[0_0_20px_rgba(249,115,22,0.35)] cursor-pointer select-none transition-all hover:scale-105"
              title="¡Haz clic para cambiar la frase!"
            >
              <span class="text-lg">🎃</span>
              <span
                id="spooky-text"
                class="text-xs md:text-sm font-bold uppercase tracking-widest text-transparent bg-clip-text bg-linear-to-r from-orange-400 via-amber-300 to-purple-300 transition-opacity duration-300"
              >
                Especial Noche de Brujas
              </span>
              <span class="text-lg">👻</span>
            </div>
          )
        }

        <header class="home-welcome">
          <img src="/favicon.svg" alt="SaltoUruguayServer" width="100" height="100" fetchpriority="high" class="home-logo" />
          <div class="home-badge"><LucideUsers size={14} /><span>Comunidad saltana</span></div>
          <h1 class:list={['font-anton text-white uppercase tracking-tight', titleShadow]}>Salto Uruguay<br /><span class:list={['text-transparent bg-clip-text bg-linear-to-r', subtitleGradient]}>Server Community</span></h1>
          <p>De Salto, Uruguay, para cualquiera que quiera ser parte.<br class="hidden sm:block" /> Directos, juegos y momentos para compartir.</p>
          <div class="home-hero-actions"><a class="home-primary" href="/comunidad">Explorar comunidad <LucideArrowRight size={18} /></a></div>
          <a class="home-first-visit" href="/como-participar">¿Primera vez? Te contamos cómo participar.</a>
        </header>
      </div>

      {/* Scroll indicator - Estilo más técnico/gaming */}
      <a
        href="#explore-title"
        class="absolute bottom-6 text-white/30 transition-all hover:-translate-y-1 hover:text-white/80 animate-bounce cursor-pointer"
        aria-label="Ir al contenido"
      >
        <LucideChevronsDown size={28} stroke-width="2" />
      </a>
    </section>

    {/* CONTENIDO PRINCIPAL */}
    <div
      class="relative z-10 mx-auto flex max-w-7xl flex-col gap-16 sm:gap-20 px-4 pb-20"
    >
      <LiveStream server:defer />
      <section class="home-explore" aria-labelledby="explore-title">
        <header class="home-section-header"><div class="home-badge"><LucideSparkles size={14} /><span>Mucho más que un directo</span></div><h2 id="explore-title" class="font-anton">Encontrá tu <span>lugar</span></h2><p>Elegí por dónde empezar. El resto lo hacemos entre todos.</p></header>
        <div class="home-explore-grid">
          <a class="home-destination home-events" href="/eventos"><img src="/images/SaltoCraft 4.webp" alt="" loading="lazy" /><div class="home-destination-copy"><span class="destination-icon"><LucideTrophy size={23} /></span><h3>Eventos y torneos</h3><p>Conocé las ediciones, los desafíos y las historias de la comunidad.</p><span class="destination-action">Explorar eventos <LucideArrowRight size={16} /></span></div></a>
          <a class="home-destination home-games" href="/comunidad/juegos"><img src="/images/arcade-bg.webp" alt="" loading="lazy" /><div class="home-destination-copy"><span class="destination-icon"><LucideGamepad2 size={23} /></span><h3>Juegos con amigos</h3><p>Conga, Ruleta Loca y una excusa más para quedarse un rato.</p><span class="destination-action">Entrar al arcade <LucideArrowRight size={16} /></span></div></a>
          <a class="home-destination home-community" href="/comunidad"><img src="/images/member-card.webp" alt="" loading="lazy" /><div class="home-destination-copy"><span class="destination-icon"><LucideIdCard size={23} /></span><h3>Tu espacio saltano</h3><p>Tu Member Card, tus logros y todo lo que te hace parte.</p><span class="destination-action">Descubrir comunidad <LucideArrowRight size={16} /></span></div></a>
        </div>
      </section>
      <FeaturedNews client:only="preact" />
      <NewsOnPage />
      <Advantages />
      <Sponsors />
    </div>
  </div>
</Layout>

<style>
  .home-welcome { display:flex; flex-direction:column; align-items:center; }
  .home-logo { width:88px; height:88px; margin-bottom:22px; object-fit:contain; filter:drop-shadow(0 0 25px #a855f744); }
  .home-badge { display:inline-flex; align-items:center; gap:8px; padding:5px 12px; border-radius:999px; border:1px solid #a855f733; background:#a855f71a; color:#d8b4fe; font:700 11px var(--font-rubik); text-transform:uppercase; letter-spacing:.08em; backdrop-filter:blur(12px); }
  .home-welcome h1 { margin-top:18px; font-size:clamp(2.7rem,6.5vw,5.5rem); line-height:1.05; }
  .home-welcome h1 span { display:inline-block; }
  .home-welcome > p { margin-top:20px; font-family:var(--font-rubik); color:#ffffff99; font-size:14px; line-height:1.8; max-width:48ch; }
  .home-hero-actions { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:14px; margin-top:28px; }
  .home-primary { display:inline-flex; align-items:center; gap:12px; border-radius:999px; padding:13px 22px; font:500 13px var(--font-rubik); transition:background .15s,border-color .15s; }
  .home-primary { background:#a855f71f; color:#f3e8ff; border:1px solid #c084fc70; }
  .home-primary:hover { background:#a855f738; border-color:#d8b4fe; }
  .home-first-visit { font:400 11px var(--font-rubik); color:#ffffff70; margin-top:22px; text-decoration:underline; text-underline-offset:4px; }
  .home-section-header { text-align:center; margin-bottom:30px; }
  .home-section-header h2 { margin-top:16px; font-size:clamp(32px,4vw,52px); line-height:1.1; text-transform:uppercase; letter-spacing:-.02em; }
  .home-section-header h2 span { color:transparent; background:linear-gradient(90deg,#c084fc,#ec4899); background-clip:text; }
  .home-section-header > p { font-family:var(--font-rubik); margin-top:12px; color:#ffffff80; font-size:13px; line-height:1.7; }
  .home-explore-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
  .home-destination { position:relative; isolation:isolate; display:flex; align-items:end; min-height:350px; border:1px solid #ffffff26; border-radius:22px; overflow:hidden; --accent:#fbbf24; background:#09090b; }
  .home-destination > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
  .home-destination::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(0deg,#09090b 0%,#09090bef 18%,#09090b80 65%,#09090b10); }
  .home-destination-copy { padding:26px; width:100%; }
  .destination-icon { display:inline-flex; padding:11px; background:#09090b99; border:1px solid var(--accent); color:var(--accent); border-radius:12px; margin-bottom:40px; }
  .home-destination h3 { font-family:var(--font-anton); font-size:29px; text-transform:uppercase; line-height:1.15; }
  .home-destination p { font-family:var(--font-rubik); color:#ffffffa6; font-size:12px; line-height:1.8; margin:12px 0 22px; max-width:33ch; }
  .destination-action { display:inline-flex; align-items:center; gap:8px; color:var(--accent); font-family:var(--font-rubik); font-size:12px; font-weight:500; }
  .home-games { --accent:#67e8f9; }
  .home-community { --accent:#d8b4fe; }
  .home-destination:hover { border-color:var(--accent); }
  .home-destination:hover h3 { color:var(--accent); }
  .home-page a:focus-visible { outline:2px solid #e9d5ff; outline-offset:5px; }
  @media(max-width:800px) { .home-explore-grid { grid-template-columns:1fr; gap:16px; } .home-destination { min-height:270px; } .home-destination > img { object-position:center 35%; } .destination-icon { margin-bottom:20px; } }
  @media(max-width:540px) { .home-welcome h1 { font-size:clamp(2.1rem,9vw,3rem); } .home-welcome > p { font-size:12px; } .home-logo { width:72px; height:72px; } .home-primary { padding:12px 16px; font-size:11px; } .home-destination-copy { padding:22px; } }
  @media(prefers-reduced-motion:reduce) { .home-page *, .home-page *::before, .home-page *::after { animation:none !important; transition:none !important; scroll-behavior:auto !important; } .animate-fade-in-up { opacity:1 !important; } }

  /* Animaciones CSS Puras */
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }

  .animate-fade-in-down {
    animation: fadeInDown 1s ease-out forwards;
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 1s ease-out 0.3s forwards;
  }

  .animate-bounce-subtle {
    animation: bounceSubtle 3s ease-in-out infinite;
  }

  @keyframes bounceSubtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Animación para el gradiente festivo */
  .animate-shine {
    animation: backgroundShine 4s linear infinite;
  }

  @keyframes backgroundShine {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 🎃 ESTILOS DE HALLOWEEN */
  .halloween-logo::before {
    content: "🎃";
    position: absolute;
    top: -28px;
    left: -18px;
    font-size: 3.5rem;
    z-index: 20;
    transform: rotate(-12deg);
    animation: pumpkinWobble 3s infinite ease-in-out;
    filter: drop-shadow(0 0 12px rgba(249, 115, 22, 0.7));
  }

  @keyframes pumpkinWobble {
    0%, 100% {
      transform: rotate(-12deg) translateY(0) scale(1);
    }
    50% {
      transform: rotate(-5deg) translateY(-8px) scale(1.08);
    }
  }

  /* Murciélagos volando en el fondo */
  .bat {
    position: absolute;
    font-size: 1.8rem;
    opacity: 0;
    z-index: 10;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    animation: flyBat 14s linear infinite;
  }

  .bat-1 {
    top: 15%;
    left: -5%;
    animation-duration: 16s;
    animation-delay: 0s;
  }
  .bat-2 {
    top: 35%;
    left: -5%;
    animation-duration: 12s;
    animation-delay: 4s;
    font-size: 1.4rem;
  }
  .bat-3 {
    top: 25%;
    left: -5%;
    animation-duration: 18s;
    animation-delay: 8s;
    font-size: 2.2rem;
  }
  .bat-4 {
    top: 45%;
    left: -5%;
    animation-duration: 15s;
    animation-delay: 2s;
    font-size: 1.6rem;
  }

  @keyframes flyBat {
    0% {
      transform: translateX(0vw) translateY(0px) rotate(5deg);
      opacity: 0;
    }
    10% {
      opacity: 0.7;
    }
    30% {
      transform: translateX(30vw) translateY(-40px) rotate(-10deg);
    }
    50% {
      transform: translateX(55vw) translateY(20px) rotate(8deg);
    }
    80% {
      transform: translateX(85vw) translateY(-30px) rotate(-5deg);
      opacity: 0.7;
    }
    100% {
      transform: translateX(105vw) translateY(10px) rotate(5deg);
      opacity: 0;
    }
  }

  /* Contenedor de Niebla (Posicionada detrás con -z-10) */
  .spooky-fog-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 220px;
    pointer-events: none;
    overflow: hidden;
  }

  .spooky-fog {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(249, 115, 22, 0.12) 0%,
      rgba(168, 85, 247, 0.08) 40%,
      transparent 75%
    );
    animation: creepFog 25s linear infinite;
  }

  .spooky-fog.fog-2 {
    animation: creepFog 18s linear infinite reverse;
    opacity: 0.7;
    background: radial-gradient(
      ellipse at center,
      rgba(168, 85, 247, 0.15) 0%,
      rgba(249, 115, 22, 0.08) 50%,
      transparent 80%
    );
  }

  @keyframes creepFog {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .particle.halloween-particle {
    background: radial-gradient(
      circle,
      rgba(249, 115, 22, 0.8) 0%,
      rgba(168, 85, 247, 0) 70%
    );
  }

  /* 🎅 ESTILOS DE NAVIDAD */
  .christmas-logo::before {
    content: "🎅";
    position: absolute;
    top: -30px;
    left: -20px;
    font-size: 4rem;
    z-index: 20;
    transform: rotate(-15deg);
    animation: bounceHat 2s infinite ease-in-out;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.3));
  }

  @keyframes bounceHat {
    0%, 100% {
      transform: rotate(-15deg) translateY(0);
    }
    50% {
      transform: rotate(-10deg) translateY(-5px);
    }
  }

  /* Efecto de Nieve (CSS Only - Performance Friendly) */
  .snow {
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(4px 4px at 100px 50px, #fff, transparent),
      radial-gradient(6px 6px at 200px 150px, #fff, transparent),
      radial-gradient(3px 3px at 300px 250px, #fff 50%, transparent),
      radial-gradient(4px 4px at 400px 350px, #fff 50%, transparent),
      radial-gradient(6px 6px at 500px 100px, #fff 50%, transparent),
      radial-gradient(3px 3px at 50px 200px, #fff 50%, transparent),
      radial-gradient(4px 4px at 150px 300px, #fff 50%, transparent),
      radial-gradient(6px 6px at 250px 400px, #fff 50%, transparent),
      radial-gradient(6px 6px at 350px 500px, #fff 50%, transparent);
    background-size: 550px 550px;
    animation: snow 10s linear infinite;
    opacity: 0.6;
  }

  .snow.layer2 {
    background-image:
      radial-gradient(4px 4px at 50px 250px, #fff, transparent),
      radial-gradient(6px 6px at 150px 350px, #fff, transparent),
      radial-gradient(3px 3px at 250px 450px, #fff 50%, transparent),
      radial-gradient(4px 4px at 350px 50px, #fff 50%, transparent);
    background-size: 350px 350px;
    animation: snow 6s linear infinite reverse;
    opacity: 0.4;
    filter: blur(1px);
  }

  .snow.layer3 {
    background-image: radial-gradient(
      3px 3px at 100px 100px,
      #fff,
      transparent
    );
    background-size: 250px 250px;
    animation: snow 4s linear infinite;
    opacity: 0.3;
  }

  @keyframes snow {
    0% {
      transform: translateY(-550px);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* ✨ PARTÍCULAS ANIMADAS DEL HERO */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(145, 70, 255, 0.8) 0%,
      rgba(145, 70, 255, 0) 70%
    );
    animation: floatParticle linear infinite;
    opacity: 0;
  }

  .particle-1 { width: 4px; height: 4px; left: 10%; animation-duration: 20s; animation-delay: 0s; }
  .particle-2 { width: 6px; height: 6px; left: 20%; animation-duration: 25s; animation-delay: 2s; }
