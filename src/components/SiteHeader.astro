---
import MenuIcon from "@/icons/MenuIcon.astro";
import type { Session } from "@auth/core/types";
import { CurrentUser } from "./CurrentUser";
import DiscordPresenceCount from "./DiscordPresenceCount";
import { Notifications } from "./Notifications";
import { LucideLock, LucideX, LucideArrowUpRight } from "lucide-preact";
import { CHRISTMAS_MODE, HALLOWEEN_MODE } from "@/config";

interface Props {
  session?: Session | null;
  hideNav?: boolean;
}

const PRERENDERED_PATHS = [
  "/",
  "/privacidad",
  "/terminos",
  "/awards",
  "/awards/*",
  "/saltocraft",
  "/acreconre",
];

const currentPath = Astro.url.pathname;
const { session, hideNav } = Astro.props;

const trueHideNav =
  hideNav ||
  new URLSearchParams(Astro.url.search).get("isInternalIframe") === "true";

const links = [
  { label: "Comunidad", url: "/comunidad" },
  {
    label: "Torneos",
    url: "/torneos",
    specialComment: "ROCKET LEAGUE",
    colorClassName: "bg-rose-500/20 text-rose-400 border-rose-500/30",
  },
  { label: "Eventos", url: "/eventos", soon: false, specialComment: "NUEVO" },
  { label: "Awards", url: "/awards" },
];

const patternToRegex = (pattern: string) => {
  const escaped = pattern.replace(/[.+?^${}()|[\]\\]/g, "\\$&");
  const regexStr =
    "^" + escaped.replace(/\\\*/g, ".*").replace(/\*/g, ".*") + "$";
  return new RegExp(regexStr);
};

const isPrerenderedPath = PRERENDERED_PATHS.some((pattern) => {
  try {
    return patternToRegex(pattern).test(currentPath);
  } catch (e) {
    return false;
  }
});

const getBadgeStyles = (label: string, colorClassName?: string) => {
  const base =
    "nav-badge text-[8px] font-bold font-rubik px-1.5 py-0.5 rounded-full border tracking-wide leading-none whitespace-nowrap pointer-events-none";

  if (
    CHRISTMAS_MODE &&
    (label.includes("VOTA") || label.includes("VOTACIÓN"))
  ) {
    return `${base} bg-green-600/20 text-green-300 border-green-500/30`;
  }
  if (label.includes("VOTA") || label.includes("VOTACIÓN")) {
    return `${base} bg-yellow-500/15 text-yellow-300 border-yellow-500/30`;
  }
  if (label.includes("NUEVO") || label.includes("ATENTOS")) {
    return `${base} bg-cyan-500/15 text-cyan-300 border-cyan-500/30`;
  }

  if (colorClassName) {
    return `${base} ${colorClassName}`;
  }

  return `${base} bg-white/8 text-white/70 border-white/15`;
};
---

{!trueHideNav && <>
  <header id="site-header" data-season={HALLOWEEN_MODE ? 'halloween' : CHRISTMAS_MODE ? 'christmas' : 'regular'}>
    <div id="nav-island">
      <a href="/" id="home-button" class:list={['site-brand', { 'christmas-logo-nav': CHRISTMAS_MODE }]} aria-label="SaltoUruguayServer, inicio">
        <span class="site-logo"><img src="/favicon.svg" alt="" width="52" height="52" loading="eager" /></span>
        <span class="site-brand-name">SALTO URUGUAY<span>SERVER COMMUNITY</span></span>
      </a>
      <nav class="desktop-navigation" aria-label="Navegación principal">{links.map(link => link.soon ?
        <span class="site-nav-link unavailable"><span>{link.label}</span><LucideLock size={12} /></span> :
        <a href={link.url} class="site-nav-link" aria-current={currentPath === link.url || currentPath.startsWith(link.url + '/') ? 'page' : undefined}>
          <span>{link.label}</span>{link.specialComment && <span class={getBadgeStyles(link.specialComment, link.colorClassName)}>{link.specialComment}</span>}<span class="nav-underline" aria-hidden="true" />
        </a>
      )}</nav>
      <div class="site-tools">
        <div class="desktop-discord"><DiscordPresenceCount client:idle transition:persist transition:name="discord-widget-count" /></div>
        {session?.user && <div class="site-notifications"><Notifications client:load transition:persist transition:name="notifications" /></div>}
        <div class="site-account"><CurrentUser user={session?.user || null} isPrerenderedPath={isPrerenderedPath} client:only="preact" transition:persist transition:name="current-user" /></div>
        <button id="mobile-menu-btn" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-drawer"><MenuIcon class="size-5" /></button>
      </div>
    </div>
  </header>

  <div id="mobile-drawer" class="drawer-hidden" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" inert>
    <div id="drawer-bg" />
    <nav id="drawer-panel" aria-label="Navegación móvil" tabindex="-1">
      <div class="drawer-heading"><a href="/" class="drawer-brand" aria-label="Ir al inicio"><img src="/favicon.svg" alt="" width="44" height="44" /><span>COMUNIDAD<br /><strong>SALTANA</strong></span></a><button id="close-drawer" type="button" aria-label="Cerrar menú"><LucideX size={22} /></button></div>
      <div class="drawer-section-label" id="drawer-title">Explorá Salto</div>
      <div class="drawer-links"><a href="/" class="drawer-link" aria-current={currentPath === '/' ? 'page' : undefined}><span>Inicio</span><LucideArrowUpRight size={18} /></a>
        {links.map(link => link.soon ? <span class="drawer-link unavailable">{link.label}<LucideLock size={15} /></span> : <a href={link.url} class="drawer-link" aria-current={currentPath === link.url || currentPath.startsWith(link.url + '/') ? 'page' : undefined}><span>{link.label}</span>{link.specialComment && <span class={getBadgeStyles(link.specialComment, link.colorClassName)}>{link.specialComment}</span>}<LucideArrowUpRight size={18} /></a>)}
      </div>
      <div class="drawer-footer"><DiscordPresenceCount client:visible /><a href="/como-participar">¿Primera vez? Conocé la comunidad <LucideArrowUpRight size={14} /></a></div>
    </nav>
  </div>
</>}

<style>
  #site-header { --nav-accent:#d8b4fe; --nav-tint:#a855f71a; --nav-border:#c084fc40; position:fixed; inset:0 0 auto; width:100%; z-index:50; padding:24px 0; transition:padding .5s; }
  #site-header[data-season='halloween'] { --nav-accent:#fdba74; --nav-tint:#f973161a; --nav-border:#f9731640; }
  #site-header[data-season='christmas'] { --nav-accent:#fca5a5; --nav-tint:#dc26261a; --nav-border:#ef444440; }
  #nav-island { position:relative; display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:18px; width:95%; max-width:80rem; margin:auto; padding:10px 22px; border:1px solid transparent; border-radius:999px; transition:max-width .5s,padding .5s,background .5s,border-color .5s,box-shadow .5s; }
  .site-brand { display:flex; align-items:center; gap:10px; position:relative; min-width:0; }
  .site-logo { position:relative; display:block; flex-shrink:0; }
  .site-logo img { display:block; width:52px; height:52px; object-fit:contain; filter:drop-shadow(0 4px 12px #0006); transition:transform .3s,width .5s,height .5s; }
  .site-brand:hover img { transform:scale(1.08); }
  .site-brand-name { display:block; font-family:var(--font-anton); font-size:16px; line-height:1.25; white-space:nowrap; max-width:150px; opacity:1; overflow:hidden; transition:max-width .5s,opacity .3s; }
  .site-brand-name > span { display:block; font-family:var(--font-rubik); font-size:7px; letter-spacing:.17em; color:var(--nav-accent); margin-top:4px; }
  .desktop-navigation { display:flex; align-items:center; justify-content:center; gap:6px; }
  .site-nav-link { position:relative; display:flex; align-items:center; justify-content:center; gap:7px; padding:10px 12px; border-radius:10px; color:#ffffff99; transition:color .2s,background .3s; white-space:nowrap; }
  .site-nav-link > span:first-child { font-family:var(--font-anton); font-size:16px; text-transform:uppercase; letter-spacing:.02em; }
  .site-nav-link:hover { color:white; background:#ffffff06; }
  .site-nav-link[aria-current='page'] { color:var(--nav-accent); background:var(--nav-tint); }
  .nav-underline { position:absolute; bottom:3px; left:50%; height:2px; width:0; opacity:0; transform:translateX(-50%); background:linear-gradient(90deg,transparent,var(--nav-accent),transparent); border-radius:999px; transition:width .3s,opacity .3s; }
  .site-nav-link:hover .nav-underline { width:55%; opacity:.6; }
  .site-nav-link[aria-current='page'] .nav-underline { width:75%; opacity:1; }
  .site-tools { display:flex; align-items:center; justify-content:end; gap:10px; min-width:0; }
  .desktop-discord { padding-right:12px; border-right:1px solid #ffffff18; opacity:.75; transition:opacity .2s; }
  .desktop-discord:hover { opacity:1; }
  .site-account { position:relative; z-index:50; }
  #mobile-menu-btn { display:none; padding:9px; border:1px solid #ffffff20; border-radius:50%; background:#ffffff05; color:#e9d5ff; cursor:pointer; }
  .unavailable { opacity:.35; cursor:not-allowed; }
  :global(#site-header.is-scrolled) { padding:8px 0; }
  :global(#site-header.is-scrolled #nav-island) { background:linear-gradient(135deg,rgba(8,8,8,.9),rgba(14,14,14,.85)); backdrop-filter:blur(20px) saturate(180%); -webkit-backdrop-filter:blur(20px) saturate(180%); border-color:rgba(255,255,255,.07); box-shadow:0 0 0 1px rgba(255,255,255,.04) inset,0 8px 32px rgba(0,0,0,.6),0 2px 8px rgba(0,0,0,.4); max-width:64rem; padding-block:6px; }
  :global(#site-header.is-scrolled #nav-island::before) { content:''; position:absolute; top:0; left:10%; right:10%; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent); border-radius:999px; pointer-events:none; }
  :global(#site-header.is-scrolled .site-brand-name) { max-width:0; opacity:0; }
  :global(#site-header.is-scrolled .site-logo img) { width:44px; height:44px; }
  #mobile-drawer { position:fixed; inset:0; z-index:60; --nav-accent:#d8b4fe; --nav-tint:#a855f71a; }
  #mobile-drawer.drawer-hidden { display:none; }
  #drawer-bg { position:absolute; inset:0; background:#000b; backdrop-filter:blur(4px); opacity:0; transition:opacity .3s; }
  #drawer-panel { position:absolute; inset:0 0 0 auto; width:min(88vw,380px); display:flex; flex-direction:column; background:radial-gradient(ellipse at 100% 0,#7c3aed24,transparent 60%),#09080e; border-left:1px solid #c084fc30; box-shadow:-20px 0 70px #0006; padding:28px 22px max(24px,env(safe-area-inset-bottom)); transform:translateX(100%); transition:transform .3s; overflow-y:auto; }
  #mobile-drawer.drawer-open #drawer-bg { opacity:1; }
  #mobile-drawer.drawer-open #drawer-panel { transform:translateX(0); }
  .drawer-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:36px; }
  .drawer-brand { display:flex; align-items:center; gap:12px; }
  .drawer-brand > span { font-family:var(--font-anton); font-size:17px; line-height:1.2; color:white; }
  .drawer-brand strong { color:#c084fc; font-weight:400; }
  #close-drawer { display:flex; padding:8px; color:#ffffff99; border:1px solid #ffffff20; border-radius:50%; cursor:pointer; }
  .drawer-section-label { font-family:var(--font-rubik); font-size:11px; color:#ffffff60; padding-left:12px; margin-bottom:12px; }
  .drawer-links { display:flex; flex-direction:column; gap:8px; }
  .drawer-link { display:flex; align-items:center; gap:10px; padding:14px 12px; color:#ffffff99; border:1px solid transparent; border-radius:12px; transition:background .2s,color .2s; }
  .drawer-link > span:first-child { font-family:var(--font-anton); text-transform:uppercase; font-size:24px; }
  .drawer-link > svg { margin-left:auto; opacity:.5; }
  .drawer-link[aria-current='page'] { color:#d8b4fe; background:#a855f71a; border-color:#c084fc33; }
  .drawer-link:hover { color:white; background:#ffffff08; }
  .drawer-footer { display:flex; flex-direction:column; align-items:start; gap:22px; margin-top:auto; padding:28px 12px 0; }
  .drawer-footer > a { display:flex; align-items:center; gap:8px; color:#c4b5fd; font-family:var(--font-rubik); font-size:11px; }
  a:focus-visible,button:focus-visible { outline:2px solid #d8b4fe; outline-offset:4px; }
  .christmas-logo-nav::before { content:'🎅'; position:absolute; top:-14px; left:-6px; font-size:22px; z-index:1; transform:rotate(-15deg); pointer-events:none; }
  @media(max-width:1270px) { .site-brand-name { display:none; } .desktop-discord { display:none; } #nav-island { gap:12px; } }
  @media(max-width:1000px) { #nav-island { display:flex; justify-content:space-between; padding-inline:16px; } .desktop-navigation { display:none; } #mobile-menu-btn { display:flex; } .site-logo img { width:44px; height:44px; } .site-brand-name { display:block; } }
  @media(max-width:540px) { #site-header { padding:16px 0; } #nav-island { gap:8px; padding-inline:12px; } .site-brand-name { display:none; } .site-tools { gap:7px; } }
  @media(prefers-reduced-motion:reduce) { #site-header,#nav-island,.site-brand-name,.site-logo img,.site-nav-link,.nav-underline,#drawer-bg,#drawer-panel { transition:none !important; } }
</style>

<script>
  let cleanup: (() => void) | undefined;
  function setupHeader() {
    cleanup?.();
    const header = document.getElementById('site-header');
    if (!header) return;
    const button = document.getElementById('mobile-menu-btn');
    const closeButton = document.getElementById('close-drawer');
    const drawer = document.getElementById('mobile-drawer');
    const background = document.getElementById('drawer-bg');
    const panel = document.getElementById('drawer-panel');
    if (!button || !drawer || !panel) return;
    const events = new AbortController();
    const options = { signal: events.signal };
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let frame = 0;
    let open = false;
    let previousOverflow = '';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1001px)');
    const focusable = () => Array.from(panel.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),[tabindex="0"]'));
    const scroll = () => header.classList.toggle('is-scrolled', window.scrollY > 20);
    const close = (restoreFocus = true) => {
      if (!open) return;
      open = false;
      cancelAnimationFrame(frame);
      drawer.classList.remove('drawer-open');
      button.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousOverflow;
      if (restoreFocus) button.focus();
      drawer.setAttribute('aria-hidden', 'true');
      drawer.inert = true;
      closeTimer = setTimeout(() => drawer.classList.add('drawer-hidden'), reducedMotion.matches ? 0 : 300);
    };
    const show = () => {
      if (open) return;
      clearTimeout(closeTimer);
      open = true;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      drawer.classList.remove('drawer-hidden');
      drawer.inert = false;
      drawer.setAttribute('aria-hidden', 'false');
      button.setAttribute('aria-expanded', 'true');
      // Commit the off-screen state before starting the slide transition.
      void panel.offsetWidth;
      frame = requestAnimationFrame(() => {
        if (!open) return;
        drawer.classList.add('drawer-open');
        (focusable()[0] ?? panel).focus();
      });
    };
    window.addEventListener('scroll', scroll, { ...options, passive: true });
    button.addEventListener('click', show, options);
    closeButton?.addEventListener('click', () => close(), options);
    background?.addEventListener('click', () => close(), options);
    panel.addEventListener('click', event => {
      if ((event.target as Element).closest('a[href]')) close();
    }, options);
    document.addEventListener('keydown', event => {
      if (!open) return;
      if (event.key === 'Escape') { event.preventDefault(); close(); }
      if (event.key !== 'Tab') return;
      const items = focusable();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }, options);
    document.addEventListener('focusin', event => {
      if (open && !panel.contains(event.target as Node)) (focusable()[0] ?? panel).focus();
    }, options);
    desktop.addEventListener('change', event => { if (event.matches) close(); }, options);
    scroll();
    cleanup = () => {
      events.abort();
      clearTimeout(closeTimer);
      cancelAnimationFrame(frame);
      if (open) document.body.style.overflow = previousOverflow;
      cleanup = undefined;
    };
  }
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
