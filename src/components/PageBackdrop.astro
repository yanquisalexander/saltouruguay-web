---
/**
 * Fondo ambiental compartido de las páginas.
 * Orbes de color vibrantes + grilla sutil con máscara radial.
 */
interface Props {
  tone?: "violet" | "amber" | "ember" | "festive";
  /** En layouts con scroll interno (admin) se usa absoluto en vez de fijo */
  fixed?: boolean;
}

const { tone = "violet", fixed = true } = Astro.props;

const tones: Record<string, [string, string, string]> = {
  violet: ["bg-violet-600/25", "bg-fuchsia-600/15", "bg-cyan-500/10"],
  amber: ["bg-amber-500/20", "bg-orange-600/15", "bg-violet-600/15"],
  ember: ["bg-orange-600/25", "bg-fuchsia-700/15", "bg-violet-600/15"],
  festive: ["bg-red-600/20", "bg-emerald-600/15", "bg-violet-600/10"],
};

const [orbA, orbB, orbC] = tones[tone];
---

<div
  aria-hidden="true"
  class={`pointer-events-none ${fixed ? "fixed inset-0 -z-10 bg-[#060608]" : "absolute inset-0 overflow-hidden"}`}
>
  <div class={`absolute -top-32 right-[-10%] w-[650px] h-[650px] blur-[160px] rounded-full ${orbA}`}></div>
  <div class={`absolute top-[35%] left-[-12%] w-[550px] h-[550px] blur-[160px] rounded-full ${orbB}`}></div>
  <div class={`absolute bottom-[-25%] right-[15%] w-[500px] h-[500px] blur-[180px] rounded-full ${orbC}`}></div>
  <div class="absolute inset-0 bg-[url('/images/pattern-grid.svg')] opacity-[0.05] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>
</div>
