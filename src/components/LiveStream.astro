---
import { SALTO_BROADCASTER_ID } from "@/config";
import { getLiveStream } from "@/utils/twitch-runtime";
import TwitchEmbed from "./TwitchEmbed.astro";
import { LucideArrowUpRight, LucideMessageSquare, LucideRadio, LucideChevronDown } from "lucide-preact";

const broadcasterId = import.meta.env.DEV ? '277624494' : SALTO_BROADCASTER_ID;
let stream: Awaited<ReturnType<typeof getLiveStream>> = null;
try {
  stream = await getLiveStream(broadcasterId);
} catch (error) {
  console.error('Could not load the live stream:', error);
}
const preview = stream?.getThumbnailUrl(1280, 720);
---

{stream && <section id="live-stream" class="live-room" aria-labelledby="live-room-title">
  <header class="live-room-heading">
    <span class="live-room-badge"><LucideRadio size={14} /><span>Estamos en vivo</span></span>
    <h2 id="live-room-title">El directo se vive <span>juntos</span></h2>
    <p>Ya empezó. Ponete cómodo y sumate al chat.</p>
  </header>
  <div class="live-room-frame">
    <div class="live-room-topbar"><span class="live-channel"><span class="live-channel-dot" />{stream.userDisplayName}</span><span class="live-channel-status">En directo</span></div>
    <div class="live-room-grid">
      <div class="live-video-column">
        <div class="live-video"><TwitchEmbed channelId={broadcasterId} username={stream.userName} placeholder={preview || ''} extraClasses="w-full aspect-video" /></div>
        <div class="live-video-info"><div><span class="live-category">{stream.gameName || 'En comunidad'}</span><h3>{stream.title}</h3></div><a href={'https://www.twitch.tv/' + stream.userName} target="_blank" rel="noopener noreferrer">Abrir en Twitch <LucideArrowUpRight size={16} /></a></div>
      </div>
      <details class="live-chat-panel" open>
        <summary><span><LucideMessageSquare size={16} />El chat saltano</span><LucideChevronDown size={16} class="live-chat-chevron" /></summary>
        <div class="live-chat-body"><saltano-live-chat data-channel={stream.userName}><p class="live-chat-placeholder">Cargando el chat de Twitch…</p></saltano-live-chat><a class="live-chat-external" href={'https://www.twitch.tv/' + stream.userName + '/chat'} target="_blank" rel="noopener noreferrer">Abrir chat en Twitch <LucideArrowUpRight size={13} /></a></div>
      </details>
    </div>
  </div>
</section>}

<style>
  .live-room { width:100%; min-width:0; font-family:var(--font-rubik); color:white; scroll-margin-top:100px; }
  .live-room-heading { text-align:center; margin-bottom:30px; }
  .live-room-badge { display:inline-flex; align-items:center; gap:8px; padding:5px 12px; border-radius:999px; color:#fda4af; background:#f43f5e12; border:1px solid #fb718533; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; }
  .live-room-heading h2 { font-family:var(--font-anton); font-weight:400; font-size:clamp(32px,4vw,52px); text-transform:uppercase; letter-spacing:-.02em; line-height:1.1; margin-top:16px; }
  .live-room-heading h2 span { color:transparent; background:linear-gradient(90deg,#c084fc,#ec4899); background-clip:text; }
  .live-room-heading > p { margin-top:12px; color:#ffffff80; font-size:13px; line-height:1.7; }
  .live-room-frame { background:#0c0912; border:1px solid #c084fc33; border-radius:22px; overflow:hidden; }
  .live-room-topbar { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 22px; border-bottom:1px solid #ffffff12; background:linear-gradient(90deg,#a855f712,transparent); }
  .live-channel { display:flex; align-items:center; gap:9px; font-size:12px; font-weight:500; }
  .live-channel-dot { width:7px; height:7px; border-radius:50%; background:#fb7185; box-shadow:0 0 12px #fb718566; }
  .live-channel-status { color:#fda4af; font-size:10px; }
  .live-room-grid { display:grid; grid-template-columns:minmax(0,1fr) 320px; align-items:stretch; }
  .live-video-column { min-width:0; }
  .live-video { aspect-ratio:16/9; background:black; }
  .live-video-info { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:22px; }
  .live-category { font-size:10px; color:#d8b4fe; }
  .live-video-info h3 { font-family:var(--font-rubik); font-weight:500; font-size:15px; line-height:1.6; margin-top:6px; overflow-wrap:anywhere; }
  .live-video-info > a { display:inline-flex; align-items:center; gap:8px; font-size:11px; color:#e9d5ff; border:1px solid #c084fc50; background:#a855f712; border-radius:999px; padding:9px 14px; flex-shrink:0; }
  .live-video-info > a:hover { background:#a855f72a; }
  .live-chat-panel { position:relative; min-width:0; border-left:1px solid #ffffff12; background:#0e0b16; }
  .live-chat-panel > summary { display:flex; align-items:center; justify-content:space-between; gap:12px; height:52px; padding:0 16px; border-bottom:1px solid #ffffff10; color:#e9d5ff; font-size:12px; list-style:none; cursor:pointer; }
  .live-chat-panel > summary::-webkit-details-marker { display:none; }
  .live-chat-panel > summary > span { display:flex; align-items:center; gap:8px; }
  .live-chat-panel[open] .live-chat-chevron { transform:rotate(180deg); }
  .live-chat-body { position:absolute; inset:52px 0 0; display:flex; flex-direction:column; }
  saltano-live-chat { display:block; flex:1; min-height:0; width:100%; }
  .live-chat-placeholder { font-size:12px; text-align:center; color:#ffffff70; padding:32px 16px; }
  .live-chat-external { display:flex; align-items:center; justify-content:center; gap:6px; padding:12px; font-size:10px; color:#c4b5fd; border-top:1px solid #ffffff10; }
  a:focus-visible, summary:focus-visible { outline:2px solid #d8b4fe; outline-offset:-3px; }
  @media(max-width:1050px) { .live-room-grid { grid-template-columns:1fr; } .live-chat-panel { border-left:0; border-top:1px solid #ffffff12; } .live-chat-body { position:static; height:400px; } }
  @media(max-width:540px) { .live-room-frame { border-radius:16px; } .live-room-topbar { padding:12px 16px; } .live-video-info { align-items:start; flex-direction:column; gap:14px; padding:18px; } .live-video-info h3 { font-size:13px; } .live-chat-body { height:360px; } }
</style>

<script>
  class SaltanoLiveChat extends HTMLElement {
    private panel: HTMLDetailsElement | null = null;
    private viewport: MediaQueryList | null = null;

    private load = () => {
      if (!this.panel?.open || this.querySelector('iframe')) return;
      const channel = this.dataset.channel;
      if (!channel) return;
      const url = new URL('https://www.twitch.tv/embed/' + encodeURIComponent(channel) + '/chat');
      url.searchParams.set('parent', window.location.hostname);
      url.searchParams.set('darkpopout', '');
      const frame = document.createElement('iframe');
      frame.src = url.href;
      frame.title = 'Chat de Twitch de ' + channel;
      frame.width = '100%';
      frame.height = '100%';
      frame.style.cssText = 'display:block;border:0;width:100%;height:100%;';
      this.replaceChildren(frame);
    };
    private syncViewport = () => {
      if (this.panel && this.viewport) this.panel.open = this.viewport.matches;
      this.load();
    };
    connectedCallback() {
      this.panel = this.closest('details');
      this.viewport = window.matchMedia('(min-width: 1051px)');
      this.panel?.addEventListener('toggle', this.load);
      this.viewport.addEventListener('change', this.syncViewport);
      this.syncViewport();
    }
    disconnectedCallback() {
      this.panel?.removeEventListener('toggle', this.load);
      this.viewport?.removeEventListener('change', this.syncViewport);
      this.querySelector('iframe')?.remove();
    }
  }
  if (!customElements.get('saltano-live-chat')) customElements.define('saltano-live-chat', SaltanoLiveChat);
</script>
