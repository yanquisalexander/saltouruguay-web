---
import { LucideChevronRight, LucideHome } from "lucide-preact";

interface BreadcrumbItem {
  text: string;
  href: string;
}

interface Props {
  pathname?: string;
  title: string;
  description?: string;
  badge?: string;
  badgeTone?: "violet" | "emerald" | "amber" | "sky" | "rose";
}

const {
  pathname = "/",
  title,
  description,
  badge,
  badgeTone = "violet",
} = Astro.props;

const pathSegments =
  pathname === "/" ? [] : pathname.split("/").filter(Boolean);

const breadcrumbs: BreadcrumbItem[] = pathSegments.map((segment, index) => {
  const href = "/" + pathSegments.slice(0, index + 1).join("/");
  let text = segment;
  if (index === 0 && segment === "admin") {
    text = "Admin";
  } else if (index === pathSegments.length - 1 && title) {
    text = title;
  } else {
    text = segment.replace(/-/g, " ");
  }

  return { text, href };
});

const badgeTones = {
  violet: "bg-violet-500/10 text-violet-300 border-violet-400/25",
  emerald: "bg-emerald-500/10 text-emerald-300 border-emerald-400/25",
  amber: "bg-amber-500/10 text-amber-300 border-amber-400/25",
  sky: "bg-sky-500/10 text-sky-300 border-sky-400/25",
  rose: "bg-rose-500/10 text-rose-300 border-rose-400/25",
};
---

<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/[0.08]">
  <div class="space-y-2 min-w-0">
    <nav
      aria-label="Breadcrumb"
      class="flex items-center gap-1.5 text-xs text-white/40 font-rubik overflow-x-auto py-0.5"
    >
      <a
        href="/admin"
        class="hover:text-violet-300 transition-colors flex items-center gap-1 shrink-0"
      >
        <LucideHome size={12} />
        <span>Admin</span>
      </a>

      {
        breadcrumbs.slice(1).map((crumb, idx) => {
          const isLast = idx === breadcrumbs.length - 2;
          return (
            <div class="flex items-center gap-1.5 shrink-0">
              <LucideChevronRight size={12} className="text-white/20" />
              {isLast ? (
                <span class="text-white/80 font-medium capitalize truncate max-w-[200px]">
                  {crumb.text}
                </span>
              ) : (
                <a
                  href={crumb.href}
                  class="hover:text-white transition-colors capitalize text-white/50"
                >
                  {crumb.text}
                </a>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-anton uppercase tracking-wide text-white leading-none">
        {title}
      </h1>

      {
        badge && (
          <span
            class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-rubik font-semibold border ${badgeTones[badgeTone]}`}
          >
            {badge}
          </span>
        )
      }
    </div>

    {
      description && (
        <p class="text-xs sm:text-sm text-white/50 font-rubik max-w-3xl leading-relaxed">
          {description}
        </p>
      )
    }
  </div>

  <div class="flex flex-wrap items-center gap-2.5 shrink-0 pt-2 md:pt-0">
    <slot name="actions" />
    <slot />
  </div>
</header>
