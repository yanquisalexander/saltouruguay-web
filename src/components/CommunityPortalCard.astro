---
import type { CommunityItem } from './CommunityCard.astro';
import { LucideArrowUpRight, LucideLock } from 'lucide-preact';
interface Props { item: CommunityItem; loggedIn: boolean; variant?: 'personal' | 'game' | 'event'; }
const { item, loggedIn, variant = 'personal' } = Astro.props;
const needsLogin = item.requiresLogin && !loggedIn && !item.soon;
const Icon = item.icon;
---
<article class:list={['portal-card', variant, { upcoming: item.soon }]}>
  <img class="portal-art" src={item.image} alt="" loading="lazy" />
  <div class="portal-copy">
    <span class="portal-icon"><Icon size={21} /></span>
    <h3>{item.title}</h3>
    <p>{item.description}</p>
    {item.soon ? <span class="portal-status">{item.soonCustomText || 'Próximamente'}</span> : needsLogin ?
      <button type="button" data-community-login class="portal-action"><LucideLock size={13} /> Iniciá sesión<span class="sr-only"> para acceder a {item.title}</span><span class="stretched-link" /></button> :
      <a class="portal-action" href={item.url || item.path} target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined}> {variant === 'event' ? 'Explorar evento' : variant === 'game' ? 'Ir a jugar' : 'Entrar'} <LucideArrowUpRight size={16} /><span class="stretched-link" /></a>}
  </div>
</article>
<style>
  .portal-card { position:relative; isolation:isolate; overflow:hidden; background:#09090b; border:1px solid #ffffff25; border-radius:18px; min-width:0; display:flex; flex-direction:column; justify-content:end; min-height:300px; }
  .portal-art { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
  .portal-card::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(0deg,#09090b 0%,#09090bf2 20%,#09090b80 65%,#09090b10); }
  .portal-copy { padding:22px; display:flex; flex-direction:column; align-items:start; }
  .portal-icon { color:var(--section-accent,#fbbf24); display:inline-flex; align-items:center; justify-content:center; padding:10px; background:#09090bbf; border:1px solid var(--section-accent,#fbbf24); border-radius:10px; margin-bottom:30px; }
  h3 { font-family:var(--font-anton); text-transform:uppercase; font-weight:400; font-size:25px; line-height:1.15; color:#fff; text-shadow:0 2px 8px #000; margin-bottom:10px; }
  p { color:#ffffffad; font-size:12px; line-height:1.7; }
  .portal-action { display:inline-flex; align-items:center; gap:8px; color:var(--section-accent,#fbbf24); border:1px solid var(--section-accent,#fbbf24); padding:8px 12px; border-radius:7px; background:#09090bbf; font-family:var(--font-anton); text-transform:uppercase; margin-top:18px; font-size:13px; letter-spacing:.03em; cursor:pointer; }
  .portal-status { display:inline-block; margin-top:18px; padding:8px 10px; font-size:11px; color:#d4d4d8; border:1px dashed #ffffff40; border-radius:7px; }
  .stretched-link { position:absolute; inset:0; z-index:2; border-radius:inherit; }
  .portal-action:focus-visible { outline:none; }
  .portal-action:focus-visible .stretched-link { outline:3px solid var(--section-accent,#fbbf24); outline-offset:-4px; }
  .portal-card:has(.portal-action:hover) { border-color:var(--section-accent,#fbbf24); box-shadow:0 0 24px #0006; }
  .portal-card:has(.portal-action:hover) h3 { color:var(--section-accent,#fbbf24); }
  .game { border:2px solid #a78bfa90; border-radius:2px; min-height:330px; box-shadow:4px 4px 0 #4c1d95; }
  .game .portal-copy { padding:22px; }
  .game .portal-icon { border-radius:0; border-color:#67e8f9; color:#67e8f9; }
  .game h3 { font-family:var(--font-press-start-2p); font-size:16px; line-height:1.8; color:#e9d5ff; }
  .game .portal-action { border-radius:0; background:#7c3aed; color:white; border:2px solid #d8b4fe; box-shadow:0 3px 0 #3b0764; }
  .event { min-height:320px; }
  .event .portal-icon { margin-bottom:36px; }
  .event h3 { font-size:24px; }
  .upcoming .portal-art { filter:grayscale(1); opacity:.4; }
  @media(max-width:540px) { .portal-copy { padding:16px; } .portal-card { min-height:310px; } .portal-icon { margin-bottom:22px; padding:8px; } h3,.event h3 { font-size:22px; } p { font-size:11px; } .portal-action { font-size:12px; padding:7px 10px; } .game { min-height:290px; } .game h3 { font-size:18px; } }
</style>
